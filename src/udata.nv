// udata.nv — the Unicode tables, and where they live.
//
// Everything else in unicode-nv is a lookup.  This module decides
// where the data being looked up comes from, and a `core` package
// cannot read a file to find out.
//
// The sizes, measured off Unicode 16.0.0's UCD by
// `tools/gen_tables.py`, are why there is more than one answer.
//
//   display width        East Asian Width plus the categories Mn, Me
//                        and Cf                     1330 entries, 5320 bytes
//   grapheme and word    the UAX #29 break properties, plus
//   breaks               Extended_Pictographic and InCB
//                                                   3079 entries, 15395 bytes
//   identifier classes   fourteen bits per range, XID_Start and
//                        XID_Continue among them    3598 entries, 17990 bytes
//   general category     every codepoint's category 4099 entries, 16396 bytes
//   case mapping         simple, special and folding, with the four
//                        properties the conditions read
//                                                   5833 entries, 56351 bytes
//   normalisation        the decompositions, the compositions, the
//                        combining classes and the quick-check bits
//                                                  14888 entries, 75642 bytes
//
// A device with 256 KB of flash can hold the first three, which are
// 38 KB together.  It cannot hold the last three, which are 148 KB,
// and still be a program.  So the package does not have one table.
// Some of them are always there, and the rest are asked for by name.
//
// `uwidth`, `ugrapheme` and the predicates in `uclass` read tables
// that are constants in this package and take no data parameter at
// all.  textwrap-nv's `WrapWidth` holds one `fn(Int) -> Int`, and a
// width function with a table parameter cannot be the value it holds.
// The consumer's signature decided that, and the sizes above say the
// decision is affordable.
//
// `unorm` and `ucase` take a `UniData`, and `data_full()` is the
// constructor that hands them the generated tables.  A program that
// never calls either never names `data_full`, so the linker never has
// a reason to keep the 148 KB of tables it cannot reach.  The
// parameter is the disclosure.  A reader of a signature sees that
// normalising costs a table, where a free function would have hidden
// it.
//
// `data_from_pack` takes the same tables as a byte slice the caller
// got from somewhere, such as a file, a flash region or an HTTP
// response.  The parse is arithmetic, so this package still performs
// no input or output, and firmware that genuinely needs normalisation
// can keep the tables out of its text section.  A device does not have
// to carry all of them.  It has to be able to reach them.
//
// Three other arrangements were rejected, and a reader will ask about
// them.
//
//   A caller-supplied table for every lookup.  It would make the width
//   function take two arguments and stop it being the value
//   textwrap-nv already accepts, and it would push a table nobody
//   wants to think about into every call site in a terminal.
//
//   A build flag that selected a smaller table.  A package whose
//   answers change with a build flag is a package whose tests prove
//   nothing about the build a user makes, and a string that normalises
//   differently on two targets is worse than one that does not
//   normalise at all.
//
//   Loading the UCD text files at run time.  A `core` package may not
//   read, the files are 2 MB of ASCII, and parsing `UnicodeData.txt`
//   at start-up is a cost every program pays for a table that never
//   changes.  `data_from_pack` takes the packed form for that reason.
//
// Every lookup behind a `UniData` comes through `t_cover`, `t_find`,
// `t_find_pair` and `t_value` below, and each of those asks one
// question.  Is this handle carrying a pack?  A handle from
// `data_full` or `data_compact` reads the constants in `udbcat`,
// `udbcase` and `udbnorm`, and one from `data_from_pack` reads the
// caller's bytes.  `unorm`, `ucase` and `uclass.category` never learn
// which, which is what keeps the three one surface.

use std.bytes
use std.list
use std.str
use udbcase
use udbcat
use udbnorm
use utbl

// The Unicode version every table in this package is generated from.
//
// It is public because a caller comparing two systems' normalisation
// needs to know whether they agree about what Unicode is, and because
// a bug report that does not name the version is a bug report about
// nothing.
pub const UNICODE_VERSION = "16.0.0"

// The magic at the front of a packed table blob, so that
// `data_from_pack` can refuse a file that is not one rather than
// index into it.
pub const PACK_MAGIC = "NVUNI1"

// The general category of every codepoint — `uclass.category`.
const T_CAT = 0

// The one-codepoint case mappings — `ucase.simple_*`.
const T_SIMPLE = 1

// The mappings that are not one to one — `ucase.full_*`.
const T_FULL = 2

// The codepoints T_FULL indexes into.
const T_FULLPOOL = 3

// Cased, Changes_When_Casefolded and Case_Ignorable.
const T_CASEP = 4

// Canonical_Combining_Class.
const T_CCC = 5

// The one-step decomposition mappings.
const T_DECOMP = 6

// The codepoints T_DECOMP indexes into.
const T_DECOMPPOOL = 7

// The primary composites, keyed on the pair.
const T_COMP = 8

// The four quick-check properties.
const T_QC = 9

// How many tables sit behind a `UniData`.  A pack carries all of them,
// in this order, so the directory is a run of lengths and needs no ids.
const T_COUNT = 10

// The byte offset of a pack's length directory, before the version
// string is counted: six bytes of magic, one format version, four bytes
// of total length and one byte of version-string length.
const PACK_HEADER = 12

// The pack format this release writes and reads.
//
// `data_from_pack` refuses any other value rather than indexing into
// bytes laid out by a scheme it does not know.
const PACK_FORMAT = 1

// The table an id names, as the constant compiled in.
//
// An `if` chain rather than a `match`, because a bare identifier in a
// match arm is a binder and not the constant it looks like.  The
// compiler says so (W0000, "unreachable match arm"), and the first arm
// would otherwise answer for every id.
@tier(app)
fn tbl_str(id: Int) -> Str
    if id == T_CAT
        udbcat.CAT
    elif id == T_SIMPLE
        udbcase.SIMPLE
    elif id == T_FULL
        udbcase.FULL
    elif id == T_FULLPOOL
        udbcase.FULLPOOL
    elif id == T_CASEP
        udbcase.CASEP
    elif id == T_CCC
        udbnorm.CCC
    elif id == T_DECOMP
        udbnorm.DECOMP
    elif id == T_DECOMPPOOL
        udbnorm.DECOMPPOOL
    elif id == T_COMP
        udbnorm.COMP
    else
        udbnorm.QC

// The entry size of the table an id names.
@tier(app)
fn tbl_esz(id: Int) -> Int
    if id == T_CAT
        udbcat.CAT_ESZ
    elif id == T_SIMPLE
        udbcase.SIMPLE_ESZ
    elif id == T_FULL
        udbcase.FULL_ESZ
    elif id == T_FULLPOOL
        udbcase.FULLPOOL_ESZ
    elif id == T_CASEP
        udbcase.CASEP_ESZ
    elif id == T_CCC
        udbnorm.CCC_ESZ
    elif id == T_DECOMP
        udbnorm.DECOMP_ESZ
    elif id == T_DECOMPPOOL
        udbnorm.DECOMPPOOL_ESZ
    elif id == T_COMP
        udbnorm.COMP_ESZ
    else
        udbnorm.QC_ESZ

// Whether this handle reads out of a caller's blob rather than out of
// the constants.
@tier(app)
fn packed(d: UniData) -> Bool
    list.is_empty(d.pack) == false

// The byte offset in a pack at which the length directory starts.
@tier(app)
fn dir_at(blob: [u8]) -> Int
    PACK_HEADER + list.get(blob, 11, 0)

// The declared length of section `id` in a pack.
@tier(app)
fn sect_len(blob: [u8], id: Int) -> Int
    utbl.pvalue(blob, dir_at(blob) + id * 4, 4)

// The byte offset at which section `id`'s payload starts in a pack.
@tier(app)
fn sect_at(blob: [u8], id: Int) -> Int
    var at = dir_at(blob) + T_COUNT * 4
    for i in 0..id
        at = at + sect_len(blob, i)
    at

// The covering lookup for `cp` in the table `id` names.
@tier(app)
fn t_cover(d: UniData, id: Int, cp: Int) -> Int
    if packed(d)
        utbl.pcover(d.pack, sect_at(d.pack, id), sect_len(d.pack, id), tbl_esz(id), cp)
    else
        utbl.cover(tbl_str(id), tbl_esz(id), cp)

// The offset of the entry keyed `cp` in the table `id` names, or -1.
//
// The offset is into whichever medium the handle reads, so it is only
// ever handed back to `t_value`.
@tier(app)
fn t_find(d: UniData, id: Int, cp: Int) -> Int
    if packed(d)
        utbl.pfind(d.pack, sect_at(d.pack, id), sect_len(d.pack, id), tbl_esz(id), cp)
    else
        utbl.find(tbl_str(id), tbl_esz(id), cp)

// The offset of the entry keyed by the pair `(a, b)`, or -1.
@tier(app)
fn t_find_pair(d: UniData, id: Int, a: Int, b: Int) -> Int
    if packed(d)
        utbl.pfind_pair(d.pack, sect_at(d.pack, id), sect_len(d.pack, id), tbl_esz(id), a, b)
    else
        utbl.find_pair(tbl_str(id), tbl_esz(id), a, b)

// The `w`-byte value at an offset `t_find` gave back.
@tier(app)
fn t_value(d: UniData, id: Int, at: Int, w: Int) -> Int
    if packed(d)
        utbl.pvalue(d.pack, at, w)
    else
        utbl.value(tbl_str(id), at, w)

// The codepoint at index `i` of a three-byte pool.
@tier(app)
fn t_pool(d: UniData, id: Int, i: Int) -> Int
    if packed(d)
        utbl.pvalue(d.pack, sect_at(d.pack, id) + i * tbl_esz(id), tbl_esz(id))
    else
        utbl.value(tbl_str(id), i * tbl_esz(id), tbl_esz(id))

// UniData is the tables that are too big to be free.
//
// Normalisation and full case mapping need a quarter of a megabyte of
// generated data.  This value is how a caller says it wants them, and
// carrying it in the signature of every function that needs them is
// how a reader sees the cost without reading the implementation.
//
// It is a handle rather than a copy.  `data_full()` returns a view
// over constants already in the binary and allocates nothing.
pub struct UniData
    // Which Unicode version the tables behind this handle describe.
    // `data_full()` answers `UNICODE_VERSION`; `data_from_pack` answers
    // whatever the blob was generated from, which is how a caller
    // catches a stale pack.
    version: Str
    // How many bytes of table this handle reaches.  A caller sizing a
    // firmware image asks this rather than guessing from the docs.
    table_bytes: Int
    // False when the handle came from `data_compact()`, which answers
    // for the Basic Multilingual Plane and nothing above it.  Every
    // function that takes a `UniData` documents what it does with a
    // codepoint the handle cannot answer for.
    complete: Bool
    // The packed tables this handle reads out of, empty for a handle
    // over the compiled-in ones.
    //
    // `data_from_pack` borrows the bytes it is given, and a struct of
    // three scalars has nowhere to keep them.  The field carries a
    // default so that a literal naming only the other three fields
    // still compiles.
    pack: [u8] = []

// data_full is the generated tables, compiled into the program.
//
// The ordinary answer.  Naming this function is what causes the
// tables to be linked, so a program that never normalises and never
// case-maps does not carry them.
//
// ```novo
// use udata
//
// fn main() [io]
//     let d = udata.data_full()
//     println(udata.data_version(d))
// ```
pub @tier(app)
fn data_full() -> UniData []
    UniData { version: UNICODE_VERSION,
        table_bytes: udbcat.BYTES + udbcase.BYTES + udbnorm.BYTES,
        complete: true }

// data_compact is the same tables cut to the Basic Multilingual Plane.
//
// An astral codepoint, such as an emoji, a historic script or a
// mathematical alphanumeric, is left exactly as it was found rather
// than normalised or case-mapped.  `complete` is false, so a caller
// that must not silently do that can check.  `table_bytes` answers the
// part of the tables this handle reaches, which is about four fifths
// of the whole.
//
// It does not make the binary smaller.  The handle reads the same
// constants `data_full` reads and refuses above U+FFFF, and there is
// no separately generated smaller table, so a program that links this
// function links all of them.  A program that needs a smaller image
// passes `data_from_pack` a blob holding only what it needs, which is
// what the packed form is for.
//
// For the program that wants canonical composition of European text and
// must not silently mis-handle an emoji.
pub @tier(app)
fn data_compact() -> UniData []
    UniData { version: UNICODE_VERSION,
        table_bytes: udbcat.BMP_BYTES + udbcase.BMP_BYTES + udbnorm.BMP_BYTES,
        complete: false }

// data_from_pack reads the tables out of bytes the caller already
// holds.
//
// The host reads the file and this parses it.  That is how a `core`
// package gets a quarter of a megabyte of data without an effect.  The
// bytes arrive as an argument.
//
// The answer is `None` when the blob does not open with `PACK_MAGIC`,
// when its declared length disagrees with what it was handed, or when
// its format version is one this release does not know.  Three
// refusals, rather than an index into a stranger's bytes.
//
// The blob is borrowed rather than copied.  Every lookup reads out of
// the slice the caller passed, so the caller must keep it alive for as
// long as the `UniData`.
pub @tier(app)
fn data_from_pack(blob: [u8]) -> ?UniData []
    let n = list.len(blob)
    if n < PACK_HEADER or magic_ok(blob) == false
        None
    elif list.get(blob, 6, 0) != PACK_FORMAT
        None
    elif utbl.pvalue(blob, 7, 4) != n
        None
    else
        let vlen = list.get(blob, 11, 0)
        if PACK_HEADER + vlen + T_COUNT * 4 > n
            None
        else
            var total = dir_at(blob) + T_COUNT * 4
            for i in 0..T_COUNT
                total = total + sect_len(blob, i)
            if total != n
                None
            else
                Some(UniData { version: pack_version(blob, vlen),
                    table_bytes: n - dir_at(blob) - T_COUNT * 4,
                    complete: true,
                    pack: blob })

// pack_bytes writes the compiled-in tables back out in the packed
// form, appended to the caller's buffer.
//
// A build step can produce the blob that `data_from_pack` takes
// without this package shipping a second program to generate one, and
// a caller can check a pack it was given against the tables it has.
pub @tier(app)
fn pack_bytes(out: [u8], d: UniData) -> [u8] []
    var total = PACK_HEADER + str.len(UNICODE_VERSION) + T_COUNT * 4
    for i in 0..T_COUNT
        total = total + str.len(tbl_str(i))
    var out2 = list.append(out, utbl.bytes_of(PACK_MAGIC))
    out2 = list.push(out2, PACK_FORMAT)
    out2 = be4(out2, total)
    out2 = list.push(out2, str.len(UNICODE_VERSION))
    out2 = list.append(out2, utbl.bytes_of(UNICODE_VERSION))
    for i in 0..T_COUNT
        out2 = be4(out2, str.len(tbl_str(i)))
    for i in 0..T_COUNT
        out2 = list.append(out2, utbl.bytes_of(tbl_str(i)))
    out2

// data_version is the Unicode version the handle's tables came from.
pub @tier(app)
fn data_version(d: UniData) -> Str []
    d.version

// data_covers answers whether the handle can speak for a codepoint.
//
// Always true for `data_full()`.  False above U+FFFF for
// `data_compact()`, and false for whatever a pack left out.  Every
// function taking a `UniData` treats a codepoint it does not cover as
// having no mapping and no decomposition, which is the identity
// answer.  So this is the question to ask before trusting a result,
// rather than a way to interpret one afterwards.
pub @tier(app)
fn data_covers(d: UniData, ch: Int) -> Bool []
    if ch < 0 or ch > 0x10FFFF
        false
    else
        d.complete or ch <= 0xFFFF

// Whether a blob opens with `PACK_MAGIC`.
@tier(app)
fn magic_ok(blob: [u8]) -> Bool
    var ok = true
    for i in 0..str.len(PACK_MAGIC)
        if list.get(blob, i, 0) != str.byte_at_or(PACK_MAGIC, i, 0)
            ok = false
    ok

// The version string a pack declares.
@tier(app)
fn pack_version(blob: [u8], vlen: Int) -> Str
    bytes.to_str(bytes.from_byte_list(list.slice(blob, PACK_HEADER, PACK_HEADER + vlen)))

// `n` appended to a buffer as four big-endian bytes.
@tier(app)
fn be4(out: [u8], n: Int) -> [u8]
    var o = out
    o = list.push(o, (n >>> 24) & 0xFF)
    o = list.push(o, (n >>> 16) & 0xFF)
    o = list.push(o, (n >>> 8) & 0xFF)
    o = list.push(o, n & 0xFF)
    o
