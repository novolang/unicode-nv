// unorm.nv — the four normalisation forms of UAX #15.

use std.list
use std.str
use udata
use utbl

// WHY NORMALISE.  "é" is two different strings: one codepoint, or an
// "e" followed by a combining acute.  They look identical, they mean
// the same thing, and `==` says they are different.  Every filename
// comparison, every login, every cache key and every deduplication
// over text a user typed is wrong until one of them has normalised.
//
// The macOS filesystem hands out NFD; almost everything else hands
// out NFC; a form that came through an IME may be neither.  A program
// that compares text from two sources and has not normalised has a
// bug it will find in production, on a name with an accent in it.
//
// EVERY FUNCTION HERE TAKES A `UniData` because the decomposition
// tables are the largest thing in this package — about 190 KB
// generated.  `udata.nv` argues why that is a parameter rather than a
// global.
//
// THE CHEAP PATH IS A FIRST-CLASS ANSWER.  Most text is already NFC,
// and a normaliser that allocates a copy to discover that is a
// normaliser a program will stop calling.  `quick_check` answers
// yes/no/maybe from a single table lookup per codepoint with no
// allocation at all, and `compare` decides canonical equivalence
// without materialising either normalised form.  Those two are what
// a hot path should call; `normalize` is for when the normalised
// string is what you actually need to keep.
//
// HANGUL IS ARITHMETIC, NOT A TABLE.  UAX #15 § 3.12 gives the
// eleven thousand syllables a formula, and `hangul_decompose` and
// `compose_pair` use it, so the tables carry none of them.  A caller
// cannot tell, which is the point.

// U+AC00, the first precomposed Hangul syllable (UAX #15 § 3.12).
const S_BASE = 0xAC00

// U+1100, the first leading jamo.
const L_BASE = 0x1100

// U+1161, the first vowel jamo.
const V_BASE = 0x1161

// U+11A7 — one BELOW the first trailing jamo, because a syllable with
// no trailing jamo is written as index zero.
const T_BASE = 0x11A7

// How many leading jamo there are.
const L_COUNT = 19

// How many vowel jamo there are.
const V_COUNT = 21

// How many trailing jamo there are, counting "none" as one of them.
const T_COUNT = 28

// The syllables one leading jamo spans: V_COUNT * T_COUNT.
const N_COUNT = 588

// How many precomposed syllables there are: L_COUNT * N_COUNT.
const S_COUNT = 11172

// The quick-check answer a table gives: certainly yes.
const QC_Y = 0

// Certainly no.
const QC_N = 1

// Possibly — the answer only NFC and NFKC ever give.
const QC_M = 2

// Whether `form` composes after decomposing.
fn composes(form: UniForm) -> Bool
    match form
        FormNfc  => true
        FormNfkc => true
        _        => false

// Whether `form` uses the compatibility decompositions.
fn compat_form(form: UniForm) -> Bool
    match form
        FormNfkd => true
        FormNfkc => true
        _        => false

// Which pair of bits in `udbnorm.QC` a form reads.
fn qc_shift(form: UniForm) -> Int
    match form
        FormNfd  => 0
        FormNfc  => 2
        FormNfkd => 4
        _        => 6

// The quick-check property of `ch` for `form`.
fn qc_of(d: udata.UniData, ch: Int, form: UniForm) -> Int
    if udata.data_covers(d, ch) == false
        QC_Y
    else
        (udata.t_cover(d, udata.T_QC, ch) >>> qc_shift(form)) & 0x03

// Whether `ch` is one of the precomposed Hangul syllables.
fn is_hangul(ch: Int) -> Bool
    ch >= S_BASE and ch < S_BASE + S_COUNT

// The jamo of a precomposed syllable, appended to `out`.
fn hangul_decompose(out: [Int], ch: Int) -> [Int]
    let index = ch - S_BASE
    var o = list.push(out, L_BASE + index / N_COUNT)
    o = list.push(o, V_BASE + index % N_COUNT / T_COUNT)
    let t = index % T_COUNT
    if t != 0
        o = list.push(o, T_BASE + t)
    o

// One codepoint's decomposition, appended to `out` and fully expanded.
//
// Recursive, because a decomposition's own parts may decompose: the
// table holds the ONE-STEP mapping, and storing the closure instead
// would repeat every shared tail in every entry that ends with it.
fn decomp_into(d: udata.UniData, out: [Int], ch: Int, compat: Bool) -> [Int]
    if is_hangul(ch)
        hangul_decompose(out, ch)
    elif udata.data_covers(d, ch) == false
        list.push(out, ch)
    else
        let at = udata.t_find(d, udata.T_DECOMP, ch)
        if at < 0
            list.push(out, ch)
        else
            let kind = udata.t_value(d, udata.T_DECOMP, at + 3, 1)
            if kind == 1 and compat == false
                list.push(out, ch)
            else
                let off = udata.t_value(d, udata.T_DECOMP, at + 4, 2)
                let n = udata.t_value(d, udata.T_DECOMP, at + 6, 1)
                var o = out
                for i in 0..n
                    o = decomp_into(d, o, udata.t_pool(d, udata.T_DECOMPPOOL, off + i), compat)
                o

// `ch` appended to `out` in canonical order.
//
// An insertion rather than a sort afterwards.  The canonical ordering
// algorithm (UAX #15 § 3.11) is defined as a stable sort of each run of
// non-starters by combining class, and inserting each mark just past
// the last one whose class is no greater IS that sort — written so the
// list is built once instead of being rewritten per swap.
fn insert_ordered(d: udata.UniData, out: [Int], ch: Int) -> [Int]
    let c = combining_class(d, ch)
    if c == 0
        list.push(out, ch)
    else
        let n = list.len(out)
        var at = n
        for _ in 0..n
            if at == 0
                break
            let pc = combining_class(d, list.get(out, at - 1, 0))
            if pc == 0 or pc <= c
                break
            at = at - 1
        if at == n
            list.push(out, ch)
        else
            list.append(list.push(list.slice(out, 0, at), ch), list.slice(out, at, n))

// The whole string decomposed and canonically ordered.
fn decomposed(d: udata.UniData, text: Str, compat: Bool) -> [Int]
    var out: [Int] = []
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        var one: [Int] = []
        one = decomp_into(d, one, utbl.cp_at(text, at), compat)
        for i in 0..list.len(one)
            out = insert_ordered(d, out, list.get(one, i, 0))
        at = at + utbl.seq_len(text, at)
    out

// The canonical composition of an already-ordered sequence.
//
// UAX #15 § 3.11: walk forward holding the index of the last starter,
// and compose a mark onto it when nothing between them BLOCKS the
// pair — nothing whose combining class is at or above the mark's.  A
// mark that composes is absorbed, so `last_cc` deliberately does not
// move: the character that would block the next mark is still the one
// before this one.
fn composed(d: udata.UniData, src: [Int]) -> [Int]
    var out: [Int] = []
    var starter = 0 - 1
    var last_cc = 0
    for i in 0..list.len(src)
        let ch = list.get(src, i, 0)
        let cc = combining_class(d, ch)
        var absorbed = false
        if starter >= 0 and (last_cc < cc or last_cc == 0)
            match compose_pair(d, list.get(out, starter, 0), ch)
                None       =>
                    absorbed = false
                Some(comp) =>
                    out[starter] = comp
                    absorbed = true
        if absorbed == false
            if cc == 0
                starter = list.len(out)
            last_cc = cc
            out = list.push(out, ch)
    out

// The normalised codepoints of `text`.
fn normalized_cps(d: udata.UniData, text: Str, form: UniForm) -> [Int]
    let parts = decomposed(d, text, compat_form(form))
    if composes(form)
        composed(d, parts)
    else
        parts

// Whether the codepoint at byte `at` is a safe place to restart.
//
// A starter the form leaves alone: nothing before it can reach across
// it and nothing after it can pull it back, so a chunk that ends before
// one can be emitted without waiting for what follows.
fn safe_starter(d: udata.UniData, text: Str, at: Int, form: UniForm) -> Bool
    let ch = utbl.cp_at(text, at)
    combining_class(d, ch) == 0 and qc_of(d, ch, form) == QC_Y

// Where the chunk of `text` that begins at byte `at` ends.
//
// The unit `compare` works in, and the boundary has to be a SAFE
// starter rather than merely a starter: normalisation reaches across an
// ordinary one.  Three Hangul jamo are three starters and NFC composes
// all three into one syllable, so a walk that cut between them would
// compare `1111` against `D4DB` and call two spellings of the same
// syllable different.  A safe starter — combining class zero AND
// quick-check Yes for the form — is the position at which normalising a
// prefix and normalising the whole give the same answer, which is the
// property `stream_boundary` publishes.
fn chunk_end(d: udata.UniData, text: Str, at: Int, form: UniForm) -> Int
    let n = str.len(text)
    var i = at + utbl.seq_len(text, at)
    for _ in 0..n
        if i >= n
            break
        if safe_starter(d, text, i, form)
            break
        i = i + utbl.seq_len(text, i)
    i

// UniForm is which normalisation form.
pub enum UniForm
    // NFD — canonical decomposition.  "é" becomes "e" plus a
    // combining acute, and the marks are sorted into canonical order.
    FormNfd
    // NFC — canonical decomposition, then canonical composition.  The
    // form the web platform specifies, and the one to store text in.
    FormNfc
    // NFKD — compatibility decomposition.  The ligature "ﬁ" becomes
    // "fi", the superscript "²" becomes "2", the fullwidth forms
    // become their narrow ones.  LOSSY, on purpose.
    FormNfkd
    // NFKC — compatibility decomposition, then canonical composition.
    // What an identifier comparison should use, and what a search
    // index should fold to.  Also lossy: do not store the result in
    // place of the original.
    FormNfkc

// UniQuickCheck is the answer to "is this already in the form".
pub enum UniQuickCheck
    // Certainly yes.  Nothing to do, and no copy was made to find
    // out.
    QcYes
    // Certainly no.  Normalising will change the string.
    QcNo
    // Possibly.  The string holds codepoints that may or may not be
    // in order — deciding needs the full algorithm.  A caller that
    // wants a definite answer calls `is_normalized`, which runs it.
    QcMaybe

// normalize is the string in the requested form.
//
// Allocates a new string.  A string already in the form is returned
// as it was — no copy — which is what makes calling this on text that
// is usually already normalised affordable.
//
// ```novo
// use udata
// use unorm
//
// fn main() [io]
//     let d = udata.data_full()
//     let nfc = unorm.normalize(d, "some text", FormNfc)
//     println(nfc)
// ```
pub fn normalize(d: udata.UniData, text: Str, form: UniForm) -> Str []
    if is_normalized(d, text, form)
        text
    else
        utbl.str_of(normalized_cps(d, text, form))

// normalize_into appends the normalised text to a caller's buffer.
//
// The allocation-free half: the caller owns the buffer, the function
// appends, and a program normalising a stream of strings reuses one
// buffer instead of producing one string per input.  The same shape
// numfmt-nv and ansi-nv use for the same reason.
pub fn normalize_into(out: [u8], d: udata.UniData, text: Str, form: UniForm) -> [u8] []
    list.append(out, utbl.utf8_of(normalized_cps(d, text, form)))

// quick_check is UAX #15's quick check, which never allocates.
//
// One table lookup per codepoint, and it stops at the first
// codepoint that makes the answer `QcNo`.  This is the function to
// call before `normalize` in anything hot.
pub fn quick_check(d: udata.UniData, text: Str, form: UniForm) -> UniQuickCheck []
    var answer = QcYes
    var last_cc = 0
    var starter = 0 - 1
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        let ch = utbl.cp_at(text, at)
        let cc = combining_class(d, ch)
        if last_cc > cc and cc != 0
            answer = QcNo
            break
        let qc = qc_of(d, ch, form)
        if qc == QC_N
            answer = QcNo
            break
        if qc == QC_M
            // The annex's table stops at "maybe" here, and one more
            // lookup settles most of them: a mark that the starter
            // before it actually composes with WILL move when the
            // string is normalised, which is `QcNo` rather than a
            // question.  Where the pair does not compose the answer
            // stays `QcMaybe` and `is_normalized` runs the algorithm.
            if starter >= 0 and (last_cc < cc or last_cc == 0) and compose_pair(d, starter, ch) != None
                answer = QcNo
                break
            answer = QcMaybe
        if cc == 0
            starter = ch
        last_cc = cc
        at = at + utbl.seq_len(text, at)
    answer

// is_normalized is the definite answer.
//
// Runs the full algorithm when `quick_check` says `QcMaybe`, so it is
// never wrong and sometimes slower.  It still allocates nothing: it
// compares as it goes rather than building the normalised form.
pub fn is_normalized(d: udata.UniData, text: Str, form: UniForm) -> Bool []
    match quick_check(d, text, form)
        QcYes   => true
        QcNo    => false
        QcMaybe => utbl.str_of(normalized_cps(d, text, form)) == text

// compare decides canonical equivalence without normalising either
// side.
//
// The function most callers actually want.  "Are these two strings
// the same name" is answered by walking both in normalised order and
// comparing as it goes — no allocation, and it stops at the first
// difference, where normalising both would have built two strings to
// throw away.
//
// Negative, zero or positive, ordered by the normalised forms, so it
// can also be a sort key comparator.
pub fn compare(d: udata.UniData, a: Str, b: Str, form: UniForm) -> Int []
    // The cheap path first: two strings that are both already in the
    // form are compared as they stand, with nothing built and nothing
    // normalised.  That is what a cache key or a filename comparison
    // hits, and it is the reason this function exists rather than
    // "normalise both and use `==`".
    if quick_check(d, a, form) == QcYes and quick_check(d, b, form) == QcYes
        compare_cps_of(a, b)
    else
        compare_chunks(d, a, b, form)

// equivalent is `compare(...) == 0`, named for the question it
// answers.
pub fn equivalent(d: udata.UniData, a: Str, b: Str, form: UniForm) -> Bool []
    compare(d, a, b, form) == 0

// combining_class is a codepoint's Canonical_Combining_Class.
//
// 0 for a starter — a base character — and 1 to 254 for the marks
// that reorder around one.  The primitive canonical ordering is
// defined in terms of, exposed because a caller writing its own
// mark-aware algorithm (a cursor that moves over a base and its
// marks, a renderer stacking diacritics) needs it and should not have
// to reimplement the table.
pub fn combining_class(d: udata.UniData, ch: Int) -> Int []
    if udata.data_covers(d, ch) == false
        0
    else
        udata.t_cover(d, udata.T_CCC, ch)

// decompose_char is a single codepoint's decomposition.
//
// The canonical one when `compat` is false, the compatibility one
// when it is true.  RECURSIVE — the result is fully decomposed, so a
// caller does not have to loop — and it is the codepoint itself, as a
// one-element list, when there is no decomposition.
//
// Hangul is computed rather than tabulated, per UAX #15 § 3.12, and
// answers here exactly as if it were.
pub fn decompose_char(d: udata.UniData, ch: Int, compat: Bool) -> [Int] []
    var out: [Int] = []
    decomp_into(d, out, ch, compat)

// compose_pair is the primary composite of a starter and a combining
// codepoint, if there is one.
//
// `None` when the pair does not compose, when the composite is in the
// composition exclusion table, or when the first codepoint is not a
// starter.  The excluded ones are the reason this is a function and
// not a reversal of `decompose_char`: a composite that decomposes
// does not necessarily recompose, and a normaliser that assumed it
// did would produce text that is not NFC.
pub fn compose_pair(d: udata.UniData, starter: Int, combining: Int) -> ?Int []
    if combining_class(d, starter) != 0
        None
    elif starter >= L_BASE and starter < L_BASE + L_COUNT and combining >= V_BASE and combining < V_BASE + V_COUNT
        Some(S_BASE + ((starter - L_BASE) * V_COUNT + (combining - V_BASE)) * T_COUNT)
    elif is_hangul(starter) and (starter - S_BASE) % T_COUNT == 0 and combining > T_BASE and combining < T_BASE + T_COUNT
        Some(starter + combining - T_BASE)
    elif udata.data_covers(d, starter) == false or udata.data_covers(d, combining) == false
        None
    else
        let at = udata.t_find_pair(d, udata.T_COMP, starter, combining)
        if at < 0
            None
        else
            Some(udata.t_value(d, udata.T_COMP, at + 6, 3))

// is_starter answers whether the codepoint has combining class 0.
//
// The boundary the whole algorithm is chunked at: a normaliser can
// process text one starter-to-starter run at a time, which is what
// makes streaming normalisation possible and what bounds the buffer
// it needs.
pub fn is_starter(d: udata.UniData, ch: Int) -> Bool []
    combining_class(d, ch) == 0

// stream_boundary is the byte offset of the last position in `text`
// at which normalisation can safely stop.
//
// For a caller normalising a stream: it hands over what it has,
// learns how much of it was safe to emit, and keeps the tail for the
// next chunk.  Without this a streaming normaliser either buffers the
// whole document or produces a wrong answer at every chunk edge — and
// the chunk edge is exactly where a combining mark will be.
//
// Zero when no position in the chunk is safe, which is what a chunk
// that is entirely combining marks deserves.
pub fn stream_boundary(d: udata.UniData, text: Str, form: UniForm) -> Int []
    var safe = 0
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        if safe_starter(d, text, at, form)
            safe = at
        at = at + utbl.seq_len(text, at)
    safe

// Two strings compared codepoint by codepoint, neither normalised.
//
// The comparison `compare` makes when both sides are already in the
// form.  Codepoints and not bytes, so the order is the order of the
// scalar values rather than of their UTF-8 encodings — which agree for
// every pair UTF-8 can encode, and saying which one is meant costs
// nothing.
fn compare_cps_of(a: Str, b: Str) -> Int
    var i = 0
    var j = 0
    var answer = 0
    for _ in 0..str.len(a) + str.len(b) + 1
        if i >= str.len(a) or j >= str.len(b)
            break
        let x = utbl.cp_at(a, i)
        let y = utbl.cp_at(b, j)
        if x != y
            answer = x - y
            break
        i = i + utbl.seq_len(a, i)
        j = j + utbl.seq_len(b, j)
    if answer != 0
        answer
    elif i >= str.len(a) and j >= str.len(b)
        0
    elif i >= str.len(a)
        0 - 1
    else
        1

// Two strings compared one chunk at a time.
//
// The slow half of `compare`.  Each side's next chunk is normalised on
// its own and the two are compared CODEPOINT BY CODEPOINT rather than
// chunk against chunk, because a chunk on one side need not produce as
// many codepoints as the chunk it lines up with: one syllable on the
// left is three jamo on the right.  The walk stops at the first
// codepoint that differs, so neither normalised string is ever built
// whole.
fn compare_chunks(d: udata.UniData, a: Str, b: Str, form: UniForm) -> Int
    var ai = 0
    var bi = 0
    var abuf: [Int] = []
    var bbuf: [Int] = []
    var ap = 0
    var bp = 0
    var answer = 0
    for _ in 0..str.len(a) + str.len(b) + 2
        if ap >= list.len(abuf) and ai < str.len(a)
            let e = chunk_end(d, a, ai, form)
            abuf = normalized_cps(d, str.slice(a, ai, e), form)
            ap = 0
            ai = e
        if bp >= list.len(bbuf) and bi < str.len(b)
            let e = chunk_end(d, b, bi, form)
            bbuf = normalized_cps(d, str.slice(b, bi, e), form)
            bp = 0
            bi = e
        let adone = ap >= list.len(abuf) and ai >= str.len(a)
        let bdone = bp >= list.len(bbuf) and bi >= str.len(b)
        if adone and bdone
            break
        if adone
            answer = 0 - 1
            break
        if bdone
            answer = 1
            break
        let x = list.get(abuf, ap, 0)
        let y = list.get(bbuf, bp, 0)
        if x != y
            answer = x - y
            break
        ap = ap + 1
        bp = bp + 1
    answer
