// ucase.nv — case mapping under the full Unicode rules, not the ASCII
// ones.

use std.list
use std.str
use udata
use ugrapheme
use unorm
use utbl

// ASCII case mapping gets three things wrong, and they are why this
// module exists rather than `str.upper` being enough.
//
//   A mapping is not one to one.  "ß" uppercases to "SS", which is two
//   codepoints, and "ﬁ" uppercases to "FI".  A function returning one
//   codepoint cannot express either, so the full forms return lists,
//   and the simple forms carry `simple` in their names so that nobody
//   reaches for one by accident.
//
//   A mapping is not length-preserving, which follows, and means that
//   `to_upper` may return a longer string than it was given.  Code
//   that assumed otherwise, such as an index kept across a case
//   conversion or a fixed buffer, breaks on real names.
//
//   A mapping depends on the language.  Turkish "i" uppercases to "İ"
//   rather than "I", and a Turkish system that uppercases "i" to "I"
//   produces a different word.  Lithuanian keeps the dot on a
//   lowercased "i" under an accent.  So the language is a parameter,
//   `LANG_ROOT` is the default, and a program that has a locale passes
//   it rather than hoping.
//
// Case folding is not lowercasing, and that distinction is the one
// most often got wrong.  Lowercasing is for display.  Folding is for
// comparison.  It maps "ß" and "ss" to the same thing so that a
// caseless match finds both, and its output is not text anybody should
// show a user.  `fold` and `to_lower` are separate functions because
// they answer separate questions, and a program that used `to_lower`
// for a caseless comparison is wrong on German input.
//
// Every function takes a `UniData`, because the mapping tables are
// 56,351 bytes generated.  `udata.nv` gives the reasoning.
//
// The language rules are context rather than a table.
// `SpecialCasing.txt` writes them as conditions, which are
// Final_Sigma, After_I, Not_Before_Dot, More_Above and
// After_Soft_Dotted, and every one of them is a question about the
// characters around the one being mapped.  So the tables carry the
// unconditional mappings and the four properties the conditions are
// written over, and the conditions themselves are the predicates
// below.

// The lowercase slot of an entry in `udbcase.SIMPLE` and `udbcase.FULL`.
const M_LOWER = 0

// The uppercase slot.
const M_UPPER = 1

// The titlecase slot.
const M_TITLE = 2

// The case-folding slot.
const M_FOLD = 3

// The Cased bit of `udbcase.CASEP`.
const C_CASED = 1

// The Changes_When_Casefolded bit.
const C_CHANGES_FOLDED = 2

// The Case_Ignorable bit, which every condition skips over.
const C_IGNORABLE = 4

// The Soft_Dotted bit, which the Lithuanian uppercase rule reads.
const C_SOFT_DOTTED = 8

// U+0307 COMBINING DOT ABOVE, which three of the five conditions are
// about.
const DOT_ABOVE = 0x0307

// U+0130 LATIN CAPITAL LETTER I WITH DOT ABOVE.
const I_DOTTED = 0x0130

// U+0131 LATIN SMALL LETTER DOTLESS I.
const I_DOTLESS = 0x0131

// U+03A3 GREEK CAPITAL LETTER SIGMA, the one codepoint whose lowercase
// depends on where in the word it stands.
const SIGMA = 0x03A3

// U+03C2 GREEK SMALL LETTER FINAL SIGMA.
const SIGMA_FINAL = 0x03C2

// U+03C3 GREEK SMALL LETTER SIGMA.
const SIGMA_MEDIAL = 0x03C3

// The combining class "above", which More_Above and After_I test for.
const CCC_ABOVE = 230

// The case-property bits of `ch`.
fn case_flags(d: udata.UniData, ch: Int) -> Int
    if udata.data_covers(d, ch) == false
        0
    else
        udata.t_cover(d, udata.T_CASEP, ch)

// The one-codepoint mapping in slot `which`, or `ch` when there is none.
fn simple_of(d: udata.UniData, ch: Int, which: Int) -> Int
    if udata.data_covers(d, ch) == false
        ch
    else
        let at = udata.t_find(d, udata.T_SIMPLE, ch)
        if at < 0
            ch
        else
            let v = udata.t_value(d, udata.T_SIMPLE, at + 3 + which * 3, 3)
            if v == 0
                ch
            else
                v

// The full mapping in slot `which`, which may be several codepoints.
//
// The simple mapping as a one-element list when the full tables have
// nothing to say, so a caller writes one loop rather than two paths.
fn full_of(d: udata.UniData, ch: Int, which: Int) -> [Int]
    var out: [Int] = []
    if udata.data_covers(d, ch)
        let at = udata.t_find(d, udata.T_FULL, ch)
        if at >= 0
            let off = udata.t_value(d, udata.T_FULL, at + 3 + which * 3, 2)
            let n = udata.t_value(d, udata.T_FULL, at + 3 + which * 3 + 2, 1)
            out = list.map(list.range(off, off + n), i => udata.t_pool(d, udata.T_FULLPOOL, i))
    if list.is_empty(out)
        [simple_of(d, ch, which)]
    else
        out

// Whether `language` is one of the two that share the Turkish rules.
//
// `SpecialCasing.txt` writes `tr` and `az` as separate conditions with
// identical mappings, and a caller that passed `tr-TR` means the same
// thing, so the tag is matched on its first two letters.
fn is_turkic(language: Str) -> Bool
    str.starts_with(language, LANG_TURKISH) or str.starts_with(language, LANG_AZERI)

// Whether `language` is Lithuanian.
fn is_lithuanian(language: Str) -> Bool
    str.starts_with(language, LANG_LITHUANIAN)

// The byte offset of the next codepoint after `at` that the conditions
// do not skip, or the length of the text.
//
// Every condition in `SpecialCasing.txt` is written "ignoring
// Case_Ignorable characters", so this is that phrase written once.
fn skip_ignorable_forward(d: udata.UniData, text: Str, at: Int) -> Int
    var i = at
    for _ in 0..str.len(text)
        if i >= str.len(text)
            break
        if (case_flags(d, utbl.cp_at(text, i)) & C_IGNORABLE) == 0
            break
        i = i + utbl.seq_len(text, i)
    i

// The codepoint before `at` that the conditions do not skip, or -1.
fn cased_before(d: udata.UniData, text: Str, at: Int) -> Int
    var i = at
    var answer = 0 - 1
    for _ in 0..str.len(text)
        if i <= 0
            break
        i = utbl.cp_start(text, i - 1)
        let ch = utbl.cp_at(text, i)
        if (case_flags(d, ch) & C_IGNORABLE) == 0
            answer = ch
            break
    answer

// Final_Sigma: a cased letter before, and none after.
//
// The condition a per-codepoint mapping cannot see, and the second
// reason the string functions exist alongside the codepoint ones.
fn final_sigma(d: udata.UniData, text: Str, at: Int, after: Int) -> Bool
    let before = cased_before(d, text, at)
    if before < 0 or (case_flags(d, before) & C_CASED) == 0
        false
    else
        let j = skip_ignorable_forward(d, text, after)
        j >= str.len(text) or (case_flags(d, utbl.cp_at(text, j)) & C_CASED) == 0

// More_Above: a combining mark above follows, with nothing of class 0
// or 230 in between.
fn more_above(d: udata.UniData, text: Str, after: Int) -> Bool
    var i = after
    var answer = false
    for _ in 0..str.len(text)
        if i >= str.len(text)
            break
        let cc = unorm.combining_class(d, utbl.cp_at(text, i))
        if cc == CCC_ABOVE
            answer = true
            break
        if cc == 0
            break
        i = i + utbl.seq_len(text, i)
    answer

// After_I: an uppercase I stands before, with nothing of class 0 or 230
// in between.
fn after_i(d: udata.UniData, text: Str, at: Int) -> Bool
    var i = at
    var answer = false
    for _ in 0..str.len(text)
        if i <= 0
            break
        i = utbl.cp_start(text, i - 1)
        let ch = utbl.cp_at(text, i)
        if ch == 0x0049
            answer = true
            break
        let cc = unorm.combining_class(d, ch)
        if cc == 0 or cc == CCC_ABOVE
            break
    answer

// After_Soft_Dotted: a Soft_Dotted letter stands before, with nothing of
// class 0 or 230 in between.
fn after_soft_dotted(d: udata.UniData, text: Str, at: Int) -> Bool
    var i = at
    var answer = false
    for _ in 0..str.len(text)
        if i <= 0
            break
        i = utbl.cp_start(text, i - 1)
        let ch = utbl.cp_at(text, i)
        if (case_flags(d, ch) & C_SOFT_DOTTED) != 0
            answer = true
            break
        let cc = unorm.combining_class(d, ch)
        if cc == 0 or cc == CCC_ABOVE
            break
    answer

// Not_Before_Dot: no COMBINING DOT ABOVE follows, with nothing of class
// 0 or 230 in between.
fn not_before_dot(d: udata.UniData, text: Str, after: Int) -> Bool
    var i = after
    var answer = true
    for _ in 0..str.len(text)
        if i >= str.len(text)
            break
        let ch = utbl.cp_at(text, i)
        if ch == DOT_ABOVE
            answer = false
            break
        let cc = unorm.combining_class(d, ch)
        if cc == 0 or cc == CCC_ABOVE
            break
        i = i + utbl.seq_len(text, i)
    answer

// The codepoints one character lowercases to, in context.
//
// The conditional half of `SpecialCasing.txt`, in the order the file
// writes the conditions: the Turkish rules, then the Lithuanian ones,
// then the final sigma, then the unconditional table.
fn lower_in_context(d: udata.UniData, text: Str, at: Int, after: Int, language: Str) -> [Int]
    let ch = utbl.cp_at(text, at)
    if is_turkic(language) and ch == I_DOTTED
        [0x0069]
    elif is_turkic(language) and ch == DOT_ABOVE and after_i(d, text, at)
        // `0307; ; 0307; 0307; tr After_I`.  The dot above is dropped,
        // because the capital it sat on lowercased to a dotted i that
        // already carries one.  An empty answer is the mapping.
        []
    elif is_turkic(language) and ch == 0x0049 and not_before_dot(d, text, after)
        [I_DOTLESS]
    elif is_lithuanian(language) and ch == 0x0049 and more_above(d, text, after)
        [0x0069, DOT_ABOVE]
    elif is_lithuanian(language) and ch == 0x004A and more_above(d, text, after)
        [0x006A, DOT_ABOVE]
    elif is_lithuanian(language) and ch == 0x012E and more_above(d, text, after)
        [0x012F, DOT_ABOVE]
    elif ch == SIGMA and final_sigma(d, text, at, after)
        [SIGMA_FINAL]
    elif ch == SIGMA
        [SIGMA_MEDIAL]
    else
        full_of(d, ch, M_LOWER)

// The codepoints one character uppercases to, in context.
fn upper_in_context(d: udata.UniData, text: Str, at: Int, language: Str) -> [Int]
    let ch = utbl.cp_at(text, at)
    if is_turkic(language) and ch == 0x0069
        [I_DOTTED]
    elif is_lithuanian(language) and ch == DOT_ABOVE and after_soft_dotted(d, text, at)
        // `0307; 0307; ; ; lt After_Soft_Dotted`.  Lithuanian writes
        // the dot on a lowercase i and drops it when the i becomes a
        // capital, which already has none.
        []
    else
        full_of(d, ch, M_UPPER)

// The codepoints `ch` folds to.
fn fold_cp(d: udata.UniData, ch: Int) -> [Int]
    full_of(d, ch, M_FOLD)

// Every codepoint of `text` mapped by `which`, in context.
//
// `which` is M_LOWER, M_UPPER or M_FOLD; titlecasing is not here
// because it is a question about words rather than about codepoints.
fn map_text(d: udata.UniData, text: Str, which: Int, language: Str) -> [Int]
    var out: [Int] = []
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        let after = at + utbl.seq_len(text, at)
        var piece: [Int] = []
        if which == M_LOWER
            piece = lower_in_context(d, text, at, after, language)
        elif which == M_UPPER
            piece = upper_in_context(d, text, at, language)
        else
            piece = fold_cp(d, utbl.cp_at(text, at))
        out = list.append(out, piece)
        at = after
    out

// One word-boundary segment titlecased: its first cased letter in the
// titlecase form, everything after it lowercased.
fn title_segment(d: udata.UniData, text: Str, start: Int, end: Int, language: Str) -> [Int]
    var out: [Int] = []
    var at = start
    var seen = false
    for _ in 0..end - start
        if at >= end
            break
        let after = at + utbl.seq_len(text, at)
        let ch = utbl.cp_at(text, at)
        var piece: [Int] = []
        if seen == false and (case_flags(d, ch) & C_CASED) != 0
            seen = true
            if is_turkic(language) and ch == 0x0069
                piece = list.push(piece, I_DOTTED)
            else
                piece = full_of(d, ch, M_TITLE)
        elif seen
            piece = lower_in_context(d, text, at, after, language)
        else
            piece = list.push(piece, ch)
        out = list.append(out, piece)
        at = after
    out

// The language tag meaning "no language-specific rules" — the default
// mapping, which is what a program with no locale should use.
pub const LANG_ROOT = ""

// Turkish, where "i" and "I" are four letters rather than two.  "i"
// uppercases to a dotted capital and "I" lowercases to a dotless
// small.  A constant rather than a string literal at every call site,
// because the whole fault is a caller who did not know this case
// existed.
pub const LANG_TURKISH = "tr"

// Azeri, which follows Turkish in the same four letters.
pub const LANG_AZERI = "az"

// Lithuanian, which keeps the dot above a lowercased "i" that carries
// another accent.
pub const LANG_LITHUANIAN = "lt"

// to_lower is the string lowercased, under the full rules.
//
// The final-sigma rule is applied.  A Greek capital sigma at the end
// of a word lowercases to "ς" and elsewhere to "σ".  That is context a
// per-codepoint mapping cannot see, and the second reason the string
// functions exist alongside the codepoint ones.
//
// ```novo
// use udata
// use ucase
//
// fn main() [io]
//     let d = udata.data_full()
//     println(ucase.to_lower(d, "STRASSE", LANG_ROOT))
// ```
pub fn to_lower(d: udata.UniData, text: Str, language: Str) -> Str []
    utbl.str_of(map_text(d, text, M_LOWER, language))

// to_upper is the string uppercased, under the full rules.
//
// May be longer than its input.  "ß" becomes "SS", "ﬁ" becomes "FI",
// and a Greek letter with a ypogegrammeni becomes two codepoints.
pub fn to_upper(d: udata.UniData, text: Str, language: Str) -> Str []
    utbl.str_of(map_text(d, text, M_UPPER, language))

// to_title is the string title-cased: the first cased letter of each
// word in its titlecase form, the rest lowercased.
//
// Word boundaries come from `ugrapheme.words`, so "o'clock" titlecases
// to "O'clock" rather than "O'Clock", because the apostrophe does not
// start a word.  That is the difference between this and a naive
// split on spaces.
//
// Titlecase is a third form rather than uppercase.  The digraph "ǳ"
// titlecases to "ǲ" and uppercases to "Ǳ".
pub fn to_title(d: udata.UniData, text: Str, language: Str) -> Str []
    var out: [Int] = []
    let segments = ugrapheme.words(text)
    for i in 0..list.len(segments)
        let w = list.get(segments, i)
        out = list.append(out, title_segment(d, text, w.start, w.end, language))
    utbl.str_of(out)

// fold is the string case-folded, for caseless comparison.
//
// Not for display.  This is the full folding, so "ß" folds to "ss"
// and a caseless search for "strasse" finds "Straße".  The result is
// stable, because folding a folded string changes nothing.
//
// There is no language parameter, and that is deliberate.  Unicode
// defines a Turkic variant of case folding, but a fold is a comparison
// key, and a comparison key that depends on the reader's locale means
// two systems disagree about whether two strings match.  A program
// that genuinely needs the Turkic fold uses `simple_fold` per
// codepoint and applies its own rule, and the README says so.
pub fn fold(d: udata.UniData, text: Str) -> Str []
    utbl.str_of(map_text(d, text, M_FOLD, LANG_ROOT))

// eq_fold is a caseless comparison that allocates nothing.
//
// Folds both sides as it walks and stops at the first difference.
// That is what a lookup table or a header-name comparison wants, where
// folding both strings to throw them away is the whole cost.
pub fn eq_fold(d: udata.UniData, a: Str, b: Str) -> Bool []
    var ai = 0
    var bi = 0
    var abuf: [Int] = []
    var bbuf: [Int] = []
    var ap = 0
    var bp = 0
    var same = true
    for _ in 0..str.len(a) + str.len(b) + 2
        if ap >= list.len(abuf) and ai < str.len(a)
            abuf = fold_cp(d, utbl.cp_at(a, ai))
            ap = 0
            ai = ai + utbl.seq_len(a, ai)
        if bp >= list.len(bbuf) and bi < str.len(b)
            bbuf = fold_cp(d, utbl.cp_at(b, bi))
            bp = 0
            bi = bi + utbl.seq_len(b, bi)
        let adone = ap >= list.len(abuf) and ai >= str.len(a)
        let bdone = bp >= list.len(bbuf) and bi >= str.len(b)
        if adone or bdone
            same = adone and bdone
            break
        if list.get(abuf, ap, 0) != list.get(bbuf, bp, 0)
            same = false
            break
        ap = ap + 1
        bp = bp + 1
    same

// to_lower_into appends the lowercased text to a caller's buffer.
pub fn to_lower_into(var out: [u8], d: udata.UniData, text: Str, language: Str) -> [u8] []
    utbl.put_all(out, utbl.utf8_of(map_text(d, text, M_LOWER, language)))

// to_upper_into appends the uppercased text to a caller's buffer.
pub fn to_upper_into(var out: [u8], d: udata.UniData, text: Str, language: Str) -> [u8] []
    utbl.put_all(out, utbl.utf8_of(map_text(d, text, M_UPPER, language)))

// fold_into appends the case-folded text to a caller's buffer.
pub fn fold_into(var out: [u8], d: udata.UniData, text: Str) -> [u8] []
    utbl.put_all(out, utbl.utf8_of(map_text(d, text, M_FOLD, LANG_ROOT)))

// simple_lower is the one-codepoint lowercase mapping.
//
// The codepoint itself when it has none.  Named `simple` because it is
// the mapping that is wrong for the cases above, and a reader of a
// call site should see which one was chosen.
pub fn simple_lower(d: udata.UniData, ch: Int) -> Int []
    simple_of(d, ch, M_LOWER)

// simple_upper is the one-codepoint uppercase mapping.
pub fn simple_upper(d: udata.UniData, ch: Int) -> Int []
    simple_of(d, ch, M_UPPER)

// simple_title is the one-codepoint titlecase mapping.
pub fn simple_title(d: udata.UniData, ch: Int) -> Int []
    simple_of(d, ch, M_TITLE)

// simple_fold is the one-codepoint case folding.
//
// The building block for a caller writing its own folding rule, such
// as the Turkic variant or a fold restricted to a script.
pub fn simple_fold(d: udata.UniData, ch: Int) -> Int []
    simple_of(d, ch, M_FOLD)

// full_lower is a codepoint's full lowercase mapping, which may be
// several codepoints.
pub fn full_lower(d: udata.UniData, ch: Int, language: Str) -> [Int] []
    if is_turkic(language) and ch == I_DOTTED
        [0x0069]
    elif is_turkic(language) and ch == 0x0049
        [I_DOTLESS]
    else
        full_of(d, ch, M_LOWER)

// full_upper is a codepoint's full uppercase mapping.
//
// Two codepoints for "ß", three for some of the Greek and Armenian
// forms.  A one-element list when the mapping is one-to-one, so the
// caller writes one loop rather than two paths.
pub fn full_upper(d: udata.UniData, ch: Int, language: Str) -> [Int] []
    if is_turkic(language) and ch == 0x0069
        [I_DOTTED]
    else
        full_of(d, ch, M_UPPER)

// is_cased answers whether the codepoint has case at all.
//
// False for a digit, a Han ideograph and punctuation, which is most of
// Unicode.  It is the question the final-sigma rule and the
// titlecasing rule are both written in terms of, and the one a caller
// asks before deciding that a string has no uppercase form rather than
// that it is already uppercase.
pub fn is_cased(d: udata.UniData, ch: Int) -> Bool []
    (case_flags(d, ch) & C_CASED) != 0

// changes_when_folded answers whether folding would change the
// codepoint.
//
// The one-codepoint form of the check that lets `eq_fold` skip a
// string it does not need to fold at all.
pub fn changes_when_folded(d: udata.UniData, ch: Int) -> Bool []
    (case_flags(d, ch) & C_CHANGES_FOLDED) != 0
