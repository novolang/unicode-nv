// ugrapheme.nv — where one user-perceived character ends and the next
// begins.  UAX #29, extended grapheme clusters.
//
// WHY A PACKAGE NEEDS THIS AT ALL.  `str.len` counts bytes and a
// codepoint iterator counts codepoints, and neither is what a user
// means by "a character".  Deleting one backspace's worth of text,
// moving a cursor one cell, truncating a name to twenty characters,
// counting the length of a password — every one of them is a question
// about grapheme clusters, and every one of them is wrong when
// answered in codepoints.  A flag is two codepoints.  An "e" with an
// acute accent typed as two is two.  A family emoji is seven.
//
// TWO SURFACES, AND THE SECOND IS THE LOAD-BEARING ONE.
//
// The first is the one a caller with a whole string in hand wants:
// `count`, `nth`, `clusters`, `next_boundary`.  Straightforward, and
// what most programs use.
//
// The second is `UniBreakState` and `break_step`: the break algorithm
// as a state machine that takes ONE codepoint at a time and answers
// "was there a boundary before this one".  A terminal emulator never
// holds the string — it holds a VTE parser handing it
// `AnsiPrint(ch)` a codepoint at a time, and it has to decide, for
// each one, whether it starts a new cell or joins the last.  A
// segmenter that needs the whole string is no use to it, and that is
// exactly the consumer this package was asked for.  novo-vte's parser
// is the producer, and this is the shape that fits it.
//
// The state machine is the same algorithm, so the two surfaces cannot
// disagree — the string functions are written on top of it.
//
// WHAT IS INCLUDED FROM UAX #29 and what is not: the extended
// grapheme cluster rules GB1 through GB999, including GB9c (the
// Indic conjunct rules added in Unicode 15.1) and GB11 (the
// Extended_Pictographic ZWJ sequences), and GB12/GB13's pairing of
// regional indicators.  LEGACY grapheme clusters — the pre-Unicode-9
// definition, which splits a base from its combining marks — are not
// here and are not wanted: nothing should be written against them.
//
// WORD BOUNDARIES are here too, because a tokenizer, a double-click
// and a "delete previous word" all want them and the table they need
// is in this package already.  SENTENCE and LINE breaking are not:
// UAX #14 line breaking is a bigger algorithm with a bigger table and
// a different consumer, and pretending a line break is a small
// addition to a grapheme segmenter is how a package ends up with a
// wrong one.
//
// WHERE THE ANSWERS COME FROM.  `udbcore.BREAK` is a 15 KB covering
// table generated by `tools/gen_tables.py` from
// `GraphemeBreakProperty.txt`, `WordBreakProperty.txt`,
// `emoji-data.txt` and `DerivedCoreProperties.txt`: four properties
// packed into two bytes per range, because they change at nearly the
// same codepoints and four tables would cost four searches.
//
// THE CLUSTER RULES ARE A STATE MACHINE AND THE WORD RULES ARE NOT,
// and the difference is lookahead.  GB1..GB999 each read the previous
// codepoint and three counters, which is exactly what `UniBreakState`
// carries, so the rules can be applied one codepoint at a time.  WB6,
// WB7b and WB12 read the codepoint AFTER the one being decided — "a
// full stop between two digits is not a break" cannot be known until
// the second digit arrives — so the word functions take a string and
// there is no incremental word surface to get wrong.

use std.list
use std.str
use udbcore
use utbl

// Where each property sits in a `udbcore.BREAK` value.
const GCB_SHIFT = 0

// Word_Break occupies the next five bits.
const WB_SHIFT = 5

// Five bits is thirty-one values, and the largest vocabulary here has
// nineteen.
const CLASS_MASK = 0x1F

// Extended_Pictographic, which only GB11 and WB3c read.
const EXTPICT_BIT = 1 << 10

// Indic_Conjunct_Break occupies the top two bits: 0 None, 1 Linker,
// 2 Consonant, 3 Extend.
const INCB_SHIFT = 11

// Two bits, so four values.
const INCB_MASK = 0x03

// The Grapheme_Cluster_Break classes, in the generator's order.
const GCB_OTHER = 0

// CR, which joins a following LF and nothing else (GB3).
const GCB_CR = 1

// LF.
const GCB_LF = 2

// Control — everything that breaks on both sides (GB4, GB5).
const GCB_CONTROL = 3

// Extend: the combining marks and the variation selectors (GB9).
const GCB_EXTEND = 4

// The zero-width joiner, which GB11 is written about.
const GCB_ZWJ = 5

// A regional indicator, which pairs (GB12, GB13).
const GCB_RI = 6

// Prepend, which joins what FOLLOWS it (GB9b).
const GCB_PREPEND = 7

// A spacing combining mark, which takes a cell and still joins (GB9a).
const GCB_SPACINGMARK = 8

// Hangul leading jamo (GB6).
const GCB_L = 9

// Hangul vowel jamo (GB7).
const GCB_V = 10

// Hangul trailing jamo (GB8).
const GCB_T = 11

// A precomposed Hangul syllable with no trailing jamo.
const GCB_LV = 12

// A precomposed Hangul syllable with one.
const GCB_LVT = 13

// InCB=Linker — the virama GB9c counts.
const INCB_LINKER = 1

// InCB=Consonant — what GB9c joins across a linker.
const INCB_CONSONANT = 2

// InCB=Extend — a mark that does not close a conjunct run.
const INCB_EXTEND = 3

// The Word_Break classes, in the generator's order.
const WB_OTHER = 0

// CR (WB3, WB3a).
const WB_CR = 1

// LF (WB3, WB3b).
const WB_LF = 2

// Newline — the other hard line terminators (WB3a, WB3b).
const WB_NEWLINE = 3

// Extend, which WB4 makes invisible to every later rule.
const WB_EXTEND = 4

// The zero-width joiner (WB3c, WB4).
const WB_ZWJ = 5

// A regional indicator (WB15, WB16).
const WB_RI = 6

// Format, which WB4 also makes invisible.
const WB_FORMAT = 7

// Katakana, which runs together (WB13).
const WB_KATAKANA = 8

// Hebrew_Letter, which has three rules of its own (WB7a, WB7b, WB7c).
const WB_HEBREW = 9

// ALetter — a letter by the word-break definition.
const WB_ALETTER = 10

// Single_Quote (WB6, WB7, WB7a, WB11, WB12).
const WB_SQUOTE = 11

// Double_Quote (WB7b, WB7c).
const WB_DQUOTE = 12

// MidNumLet — a character that joins letters AND numbers.
const WB_MIDNUMLET = 13

// MidLetter — a character that joins letters only (WB6, WB7).
const WB_MIDLETTER = 14

// MidNum — a character that joins numbers only (WB11, WB12).
const WB_MIDNUM = 15

// Numeric (WB8, WB9, WB10, WB11, WB12).
const WB_NUMERIC = 16

// ExtendNumLet — the connectors (WB13a, WB13b).
const WB_EXTENDNUMLET = 17

// WSegSpace — a space that runs together with the next one (WB3d).
const WB_WSEGSPACE = 18

// How far back `safe_start` will look for a position where a cluster
// boundary is certain without rescanning the whole string.
//
// `prev_boundary` is what a backspace key calls, and an editor pressing
// backspace in a long line must not rescan the line.  Sixty-four
// codepoints is past the longest cluster anybody writes — the longest
// in the UCD's own test file is eight — and the fall-back when nothing
// in that window is safe is the start of the string, which is correct
// and merely slower.
const SAFE_WINDOW = 64

// The packed break value of `ch`.
@tier(embedded)
fn break_value(ch: Int) -> Int
    if ch < 0 or ch > 0x10FFFF
        0
    else
        utbl.cover(udbcore.BREAK, udbcore.BREAK_ESZ, ch)

// The Grapheme_Cluster_Break class of `ch`.
@tier(embedded)
fn gcb(ch: Int) -> Int
    (break_value(ch) >>> GCB_SHIFT) & CLASS_MASK

// The Word_Break class of `ch`.
@tier(embedded)
fn wb(ch: Int) -> Int
    (break_value(ch) >>> WB_SHIFT) & CLASS_MASK

// Whether `ch` is Extended_Pictographic — an emoji, for GB11 and WB3c.
@tier(embedded)
fn extpict(ch: Int) -> Bool
    (break_value(ch) & EXTPICT_BIT) != 0

// The Indic_Conjunct_Break class of `ch`, for GB9c.
@tier(embedded)
fn incb(ch: Int) -> Int
    (break_value(ch) >>> INCB_SHIFT) & INCB_MASK

// Whether `ch` is a regional indicator.
//
// Read by `uwidth`, which has to know that a pair of them is one flag
// in two cells although each is one cell on its own.
@tier(embedded)
fn is_regional_indicator(ch: Int) -> Bool
    gcb(ch) == GCB_RI

// Whether a cluster boundary at byte `i` is certain without knowing
// what precedes it.
//
// Every rule that joins a codepoint BACKWARDS names a class: GB3 an
// LF, GB6/GB7/GB8 a jamo, GB9 an Extend or a ZWJ, GB9a a SpacingMark,
// GB9b a Prepend before it, GB9c an InCB consonant, GB11 a pictograph,
// GB12/GB13 a regional indicator.  A codepoint that is none of those,
// and that no Prepend precedes, cannot be joined to what came before
// it — so a fresh machine started here gives the same answer as one
// that walked the whole string.
@tier(embedded)
fn safe_here(text: Str, i: Int) -> Bool
    let ch = utbl.cp_at(text, i)
    if gcb(ch) != GCB_OTHER or incb(ch) != 0 or extpict(ch)
        false
    elif i <= 0
        true
    else
        gcb(utbl.cp_at(text, utbl.cp_start(text, i - 1))) != GCB_PREPEND

// The nearest certain cluster boundary at or before `at`.
//
// Zero when nothing within `SAFE_WINDOW` codepoints qualifies, which is
// correct and merely means the walk starts from the beginning.
@tier(embedded)
fn safe_start(text: Str, at: Int) -> Int
    var i = utbl.cp_start(text, at)
    var found = 0
    for _ in 0..SAFE_WINDOW
        if i <= 0
            break
        if safe_here(text, i)
            found = i
            break
        i = utbl.cp_start(text, i - 1)
    found

// The letter bit of `udbcore.PRED`.
//
// `word_kind` reads it so that a script whose Word_Break property is
// Other — Han, Thai, Khmer — is still reported as letters rather than
// as punctuation.  UAX #29 leaves those scripts to a dictionary; a
// caller asking what a segment HOLDS is better served by the category
// than by the absence of a word-break class.
const PRED_LETTER = 1 << 0

// The any-number bit of `udbcore.PRED`.
const PRED_NUMBER = 1 << 2

// The White_Space bit of `udbcore.PRED`.
const PRED_SPACE = 1 << 3

// The predicate bits of `ch`.
@tier(app)
fn pred_of(ch: Int) -> Int
    if ch < 0 or ch > 0x10FFFF
        0
    else
        utbl.cover(udbcore.PRED, udbcore.PRED_ESZ, ch)

// Whether `c` is AHLetter — ALetter or Hebrew_Letter, which UAX #29 § 4
// treats as one class in WB5 through WB10.
@tier(app)
fn is_ahletter(c: Int) -> Bool
    c == WB_ALETTER or c == WB_HEBREW

// Whether `c` is MidLetter or MidNumLetQ, the class WB6 and WB7 join
// two letters across.
@tier(app)
fn is_midletterq(c: Int) -> Bool
    c == WB_MIDLETTER or c == WB_MIDNUMLET or c == WB_SQUOTE

// Whether `c` is MidNum or MidNumLetQ, the class WB11 and WB12 join two
// numbers across.
@tier(app)
fn is_midnumq(c: Int) -> Bool
    c == WB_MIDNUM or c == WB_MIDNUMLET or c == WB_SQUOTE

// The Word_Break class `skip` places before `at`, with the Extend,
// Format and ZWJ that WB4 makes invisible passed over; -1 when the text
// runs out first.
@tier(app)
fn wb_before(text: Str, at: Int, skip: Int) -> Int
    var i = at
    var left = skip
    var answer = 0 - 1
    for _ in 0..str.len(text)
        if i <= 0
            break
        i = utbl.cp_start(text, i - 1)
        let c = wb(utbl.cp_at(text, i))
        if c != WB_EXTEND and c != WB_FORMAT and c != WB_ZWJ
            if left == 0
                answer = c
                break
            left = left - 1
    answer

// The Word_Break class `skip` places at or after `at`, under the same
// WB4 rule; -1 when the text runs out first.
@tier(app)
fn wb_after(text: Str, at: Int, skip: Int) -> Int
    let n = str.len(text)
    var i = at
    var left = skip
    var answer = 0 - 1
    for _ in 0..n
        if i >= n
            break
        let c = wb(utbl.cp_at(text, i))
        i = i + utbl.seq_len(text, i)
        if c != WB_EXTEND and c != WB_FORMAT and c != WB_ZWJ
            if left == 0
                answer = c
                break
            left = left - 1
    answer

// How many regional indicators run up to `at`, for WB15 and WB16.
@tier(app)
fn ri_run_before(text: Str, at: Int) -> Int
    var i = at
    var n = 0
    for _ in 0..str.len(text)
        if i <= 0
            break
        let j = utbl.cp_start(text, i - 1)
        let c = wb(utbl.cp_at(text, j))
        if c == WB_EXTEND or c == WB_FORMAT or c == WB_ZWJ
            i = j
        elif c == WB_RI
            n = n + 1
            i = j
        else
            break
    n

// Whether a WORD boundary falls at byte `at`, per UAX #29 § 4.
//
// WB1 and WB2 make the ends of the text boundaries; every other arm is
// one of the annex's rules in its own order.  The three that read
// `nnc` — WB6, WB7b and WB12 — are the lookahead that keeps the word
// rules out of `break_step`.
@tier(app)
fn is_word_boundary(text: Str, at: Int) -> Bool
    let n = str.len(text)
    if at <= 0 or at >= n
        true
    else
        let nxt = utbl.cp_at(text, at)
        let prv = utbl.cp_at(text, utbl.cp_start(text, at - 1))
        let pc0 = wb(prv)
        let nc = wb(nxt)
        var brk = true
        if pc0 == WB_CR and nc == WB_LF
            brk = false
        elif pc0 == WB_NEWLINE or pc0 == WB_CR or pc0 == WB_LF
            brk = true
        elif nc == WB_NEWLINE or nc == WB_CR or nc == WB_LF
            brk = true
        elif pc0 == WB_ZWJ and extpict(nxt)
            brk = false
        elif pc0 == WB_WSEGSPACE and nc == WB_WSEGSPACE
            brk = false
        elif nc == WB_EXTEND or nc == WB_FORMAT or nc == WB_ZWJ
            brk = false
        else
            let pc = wb_before(text, at, 0)
            let ppc = wb_before(text, at, 1)
            let nnc = wb_after(text, at + utbl.seq_len(text, at), 0)
            if is_ahletter(pc) and is_ahletter(nc)
                brk = false
            elif is_ahletter(pc) and is_midletterq(nc) and is_ahletter(nnc)
                brk = false
            elif is_ahletter(ppc) and is_midletterq(pc) and is_ahletter(nc)
                brk = false
            elif pc == WB_HEBREW and nc == WB_SQUOTE
                brk = false
            elif pc == WB_HEBREW and nc == WB_DQUOTE and nnc == WB_HEBREW
                brk = false
            elif ppc == WB_HEBREW and pc == WB_DQUOTE and nc == WB_HEBREW
                brk = false
            elif pc == WB_NUMERIC and nc == WB_NUMERIC
                brk = false
            elif is_ahletter(pc) and nc == WB_NUMERIC
                brk = false
            elif pc == WB_NUMERIC and is_ahletter(nc)
                brk = false
            elif ppc == WB_NUMERIC and is_midnumq(pc) and nc == WB_NUMERIC
                brk = false
            elif pc == WB_NUMERIC and is_midnumq(nc) and nnc == WB_NUMERIC
                brk = false
            elif pc == WB_KATAKANA and nc == WB_KATAKANA
                brk = false
            elif nc == WB_EXTENDNUMLET and (is_ahletter(pc) or pc == WB_NUMERIC or pc == WB_KATAKANA or pc == WB_EXTENDNUMLET)
                brk = false
            elif pc == WB_EXTENDNUMLET and (is_ahletter(nc) or nc == WB_NUMERIC or nc == WB_KATAKANA)
                brk = false
            elif nc == WB_RI and ri_run_before(text, at) % 2 == 1
                brk = false
        brk

// What the segment starting at byte `start` holds.
@tier(app)
fn word_kind(text: Str, start: Int) -> UniWordKind
    let ch = utbl.cp_at(text, start)
    let c = wb(ch)
    let p = pred_of(ch)
    if c == WB_NUMERIC or (p & PRED_NUMBER) != 0
        WordNumeric
    elif c == WB_ALETTER or c == WB_HEBREW or c == WB_KATAKANA or c == WB_EXTENDNUMLET or (p & PRED_LETTER) != 0
        WordLetters
    elif c == WB_WSEGSPACE or c == WB_CR or c == WB_LF or c == WB_NEWLINE or (p & PRED_SPACE) != 0
        WordSpace
    else
        WordOther

// UniCluster is a byte range into the string it came from.
//
// A range rather than a copied `Str` because the whole point of
// segmenting is to then slice, and a segmenter that allocated a
// string per cluster would allocate once per character of the input.
// `start` is inclusive, `end` exclusive, both in bytes.
pub struct UniCluster
    start: Int
    end: Int

// UniCursor walks the clusters of a string without allocating.
//
// The value is the position; `cursor_next` returns the next one
// rather than mutating, so a caller can keep a cursor to come back
// to — which is what a text editor does when it renders a line and
// then has to answer where the cursor goes.
pub struct UniCursor
    // The string being walked.  Held so that `cursor_next` needs one
    // argument rather than two, and so that a cursor cannot be used
    // against a different string by accident.
    text: Str
    // The byte offset of the next cluster to return.  Equal to the
    // string's length when the walk is finished.
    at: Int

// UniBreakState is the segmentation algorithm between two codepoints.
//
// Small and copyable: the previous codepoint's break property, the
// two counters GB12/GB13 and GB9c need, and the flag GB11 needs.  A
// terminal keeps one of these per line and feeds it the codepoints
// the parser hands it.
pub @value
struct UniBreakState
    // The Grapheme_Cluster_Break property of the last codepoint fed,
    // as the packed integer the tables use.  `BREAK_START` before any
    // codepoint has been fed, which is what makes the first
    // `break_step` report a boundary.
    previous: Int
    // How many regional indicators are in the run that ends at the
    // last codepoint.  GB12 and GB13 break between every SECOND pair,
    // which cannot be decided from the previous codepoint alone.
    regional_run: Int
    // True when the run so far could still be an Extended_Pictographic
    // ZWJ sequence — an emoji, then any number of Extend, then a ZWJ.
    // GB11's whole content.
    pictographic_run: Bool
    // How many linkers (virama) have been seen in the current Indic
    // conjunct run.  GB9c, added in Unicode 15.1.  Negative when no
    // conjunct run is open at all, which is the state a codepoint that
    // is neither a consonant nor a mark leaves behind.
    linker_run: Int

// The value `UniBreakState.previous` carries before any codepoint has
// been fed, so that the first `break_step` reports a boundary (GB1 —
// there is always a break at the start of text).
pub const BREAK_START = 0 - 1

// UniBreakStep is what one codepoint did to the machine.
//
// Returned as a value rather than mutating the state, because the
// state is a value and a caller that wants to look ahead without
// committing should be able to.
pub @value
struct UniBreakStep
    // The machine after the codepoint.  Feed this to the next call.
    state: UniBreakState
    // True when a cluster boundary falls BEFORE this codepoint — so
    // the codepoint starts a new cluster.  True on the very first
    // call, always.
    boundary: Bool

// UniWordKind says what a word-boundary segment holds.
//
// Because "split into words" is never the whole question: a
// tokenizer wants the letters and not the spaces, a word-count wants
// the same, and a double-click that selected the run of spaces
// between two words did the wrong thing.
pub enum UniWordKind
    // Letters, marks and the connectors that hold them together —
    // what a reader would call a word.
    WordLetters
    // Digits, and the separators inside a number.
    WordNumeric
    // A run of whitespace.
    WordSpace
    // Punctuation, symbols, and anything that is none of the above.
    WordOther

// UniWord is a word-boundary segment and what kind it is.
pub struct UniWord
    start: Int
    end: Int
    kind: UniWordKind

// break_state is a fresh segmentation machine.
//
// ```novo
// use ugrapheme
//
// fn main() [io]
//     let s = ugrapheme.break_state()
//     let step = ugrapheme.break_step(s, 0x41)
//     if step.boundary
//         println("a new cluster starts here")   // GB1, always
// ```
pub @tier(embedded)
fn break_state() -> UniBreakState []
    UniBreakState { previous: BREAK_START,
        regional_run: 0,
        pictographic_run: false,
        linker_run: 0 - 1 }

// break_step feeds one codepoint to the machine.
//
// **The load-bearing interface.**  One codepoint in, a boundary
// answer and the next state out, and no string anywhere — which is
// what lets a terminal emulator that receives text a byte at a time
// decide, per codepoint, whether it opens a new cell.
//
// The boundary reported is the one BEFORE `ch`, so a caller places
// the codepoint after acting on the answer.  There is no way to ask
// about the boundary after the last codepoint of the text, because
// there is always one (GB2) and a call would only be able to say so.
pub @tier(embedded)
fn break_step(s: UniBreakState, ch: Int) -> UniBreakStep []
    let p = s.previous
    let c = gcb(ch)
    let ic = incb(ch)
    // GB1..GB999, in the annex's own order.  Every arm is one of the
    // annex's rules and carries its number, so a reader can check this
    // against UAX #29 § 3.1 line by line rather than by reasoning.
    var brk = true
    if p == BREAK_START
        brk = true
    elif p == GCB_CR and c == GCB_LF
        brk = false
    elif p == GCB_CONTROL or p == GCB_CR or p == GCB_LF
        brk = true
    elif c == GCB_CONTROL or c == GCB_CR or c == GCB_LF
        brk = true
    elif p == GCB_L and (c == GCB_L or c == GCB_V or c == GCB_LV or c == GCB_LVT)
        brk = false
    elif (p == GCB_LV or p == GCB_V) and (c == GCB_V or c == GCB_T)
        brk = false
    elif (p == GCB_LVT or p == GCB_T) and c == GCB_T
        brk = false
    elif c == GCB_EXTEND or c == GCB_ZWJ
        brk = false
    elif c == GCB_SPACINGMARK
        brk = false
    elif p == GCB_PREPEND
        brk = false
    elif ic == INCB_CONSONANT and s.linker_run >= 1
        brk = false
    elif p == GCB_ZWJ and s.pictographic_run and extpict(ch)
        brk = false
    elif c == GCB_RI and s.regional_run % 2 == 1
        brk = false
    // The three counters, each of which exists because one rule cannot
    // be decided from the previous codepoint alone.
    var regional = 0
    if c == GCB_RI
        regional = s.regional_run + 1
    var pict = false
    if extpict(ch)
        pict = true
    elif s.pictographic_run and (c == GCB_EXTEND or c == GCB_ZWJ)
        pict = true
    var linkers = 0 - 1
    if ic == INCB_CONSONANT
        linkers = 0
    elif s.linker_run >= 0 and ic == INCB_LINKER
        linkers = s.linker_run + 1
    elif s.linker_run >= 0 and ic == INCB_EXTEND
        linkers = s.linker_run
    let next = UniBreakState { previous: c,
        regional_run: regional,
        pictographic_run: pict,
        linker_run: linkers }
    UniBreakStep { state: next, boundary: brk }

// cursor starts a walk at the beginning of a string.
pub @tier(app)
fn cursor(text: Str) -> UniCursor []
    UniCursor { text: text, at: 0 }

// cursor_at starts a walk at a byte offset.
//
// The offset must be a codepoint boundary; one that is not is moved
// BACK to the nearest, rather than producing a range that cuts a
// codepoint in half.  It need not be a CLUSTER boundary — a caller
// resuming in the middle of a cluster gets the remainder as its first
// answer, which is the only thing it can get without rescanning from
// the start.
pub @tier(app)
fn cursor_at(text: Str, offset: Int) -> UniCursor []
    UniCursor { text: text, at: utbl.cp_start(text, offset) }

// cursor_next is the next cluster, or `None` at the end.
//
// Returns the cluster and leaves the caller to advance: a walk is
// `cursor_next` for the range and `cursor_advance` for the next
// cursor, so that a caller can look at a cluster and decide not to
// consume it.
pub @tier(app)
fn cursor_next(c: UniCursor) -> ?UniCluster []
    if c.at >= str.len(c.text)
        None
    else
        Some(UniCluster { start: c.at, end: next_boundary(c.text, c.at) })

// cursor_advance is the cursor positioned after the cluster.
pub @tier(app)
fn cursor_advance(c: UniCursor) -> UniCursor []
    UniCursor { text: c.text, at: next_boundary(c.text, c.at) }

// cursor_done answers whether the walk has reached the end.
pub @tier(embedded)
fn cursor_done(c: UniCursor) -> Bool []
    c.at >= str.len(c.text)

// next_boundary is the byte offset of the next cluster boundary after
// `from`.
//
// The string's length when `from` is already in the last cluster, so
// a loop terminates without a special case.
pub @tier(embedded)
fn next_boundary(text: Str, from: Int) -> Int []
    let n = str.len(text)
    if from >= n
        n
    else
        var found = n
        var at = safe_start(text, from)
        var st = break_state()
        for _ in 0..n
            if at >= n
                break
            let step = break_step(st, utbl.cp_at(text, at))
            if step.boundary and at > from
                found = at
                break
            st = step.state
            at = at + utbl.seq_len(text, at)
        found

// prev_boundary is the byte offset of the cluster boundary before
// `from`.
//
// What a backspace key needs, and the reason it is a function rather
// than "walk from the start and remember": an editor pressing
// backspace in a long line should not rescan the line.
//
// Zero when `from` is already in the first cluster.
pub @tier(embedded)
fn prev_boundary(text: Str, from: Int) -> Int []
    if from <= 0
        0
    else
        // The safe restart has to be strictly before `from`: starting
        // it AT `from` would find the boundary the caller is standing
        // on and report that, which is a backspace that does nothing.
        var last = safe_start(text, utbl.cp_start(text, from - 1))
        var at = last
        var st = break_state()
        let n = str.len(text)
        for _ in 0..n
            if at >= n or at >= from
                break
            let step = break_step(st, utbl.cp_at(text, at))
            if step.boundary and at < from
                last = at
            st = step.state
            at = at + utbl.seq_len(text, at)
        last

// is_boundary answers whether a byte offset is a cluster boundary.
//
// False for an offset in the middle of a codepoint, as well as for
// one in the middle of a cluster — an offset that is not a character
// boundary is not a cluster boundary either.
pub @tier(embedded)
fn is_boundary(text: Str, at: Int) -> Bool []
    if utbl.cp_start(text, at) != at
        false
    elif at <= 0 or at >= str.len(text)
        true
    else
        next_boundary(text, prev_boundary(text, at)) == at

// count is how many clusters the string holds.
//
// The answer to "how long is this name", which is the question
// `str.len` is so often asked in place of.
pub @tier(embedded)
fn count(text: Str) -> Int []
    var n = 0
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        at = next_boundary(text, at)
        n = n + 1
    n

// nth is the byte range of cluster number `index`, counting from 0.
//
// `None` past the end.  A range rather than a `Str`, for the same
// reason `UniCluster` is one.
pub @tier(app)
fn nth(text: Str, index: Int) -> ?UniCluster []
    var found: ?UniCluster = None
    var i = 0
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        let end = next_boundary(text, at)
        if i == index
            found = Some(UniCluster { start: at, end: end })
            break
        at = end
        i = i + 1
    found

// clusters is every cluster's range, in order.
//
// The allocating convenience.  It is here because a caller that
// genuinely wants the list should not have to write the loop, and it
// is documented as allocating so that a caller in a hot path knows to
// use the cursor instead.
pub @tier(app)
fn clusters(text: Str) -> [UniCluster] []
    var out: [UniCluster] = []
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        let end = next_boundary(text, at)
        out = list.push(out, UniCluster { start: at, end: end })
        at = end
    out

// truncate_clusters is the byte length of the first `count` clusters.
//
// For "show the first 20 characters", where cutting at 20 bytes
// splits a codepoint and cutting at 20 codepoints splits a family
// emoji into a hand and a child.
pub @tier(embedded)
fn truncate_clusters(text: Str, count: Int) -> Int []
    var n = 0
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text) or n >= count
            break
        at = next_boundary(text, at)
        n = n + 1
    at

// next_word is the byte offset of the next word boundary after
// `from`, per UAX #29 § 4.
pub @tier(app)
fn next_word(text: Str, from: Int) -> Int []
    let n = str.len(text)
    var at = utbl.cp_start(text, from) + utbl.seq_len(text, utbl.cp_start(text, from))
    if from >= n
        at = n
    var found = n
    for _ in 0..n
        if at >= n
            break
        if is_word_boundary(text, at)
            found = at
            break
        at = at + utbl.seq_len(text, at)
    found

// prev_word is the byte offset of the word boundary before `from`.
//
// What "delete the previous word" needs.
pub @tier(app)
fn prev_word(text: Str, from: Int) -> Int []
    var last = 0
    var at = 0
    let n = str.len(text)
    for _ in 0..n
        if at >= n or at >= from
            break
        if at > 0 and is_word_boundary(text, at)
            last = at
        at = at + utbl.seq_len(text, at)
    last

// words is every word-boundary segment with its kind.
//
// Including the spaces and the punctuation, as `WordSpace` and
// `WordOther` — a caller that wants only the words filters, and one
// that wants to rebuild the string from the segments can.  A
// segmenter that dropped the gaps would be lossy, and a tokenizer
// that needs to report a byte offset cannot use a lossy one.
pub @tier(app)
fn words(text: Str) -> [UniWord] []
    var out: [UniWord] = []
    let n = str.len(text)
    var start = 0
    var at = 0
    for _ in 0..n
        if at >= n
            break
        at = at + utbl.seq_len(text, at)
        if at >= n or is_word_boundary(text, at)
            out = list.push(out, UniWord { start: start, end: at, kind: word_kind(text, start) })
            start = at
    out
