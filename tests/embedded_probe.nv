// embedded_probe.nv — the modules this package builds for a device, as
// a program that either builds for a Cortex-M or does not.
//
// It is not a test.  `scripts/shard_audit.sh`'s `core-embedded` check
// copies it and the modules it names into a package of its own and
// runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.
//
// `uwidth`, `ugrapheme` and `uclass`'s predicates read tables of about
// 38 KB in total, and a device driving a serial console or a small
// display needs exactly them.  How many cells does this character
// take, and where does one character end.  Those three modules are
// what this probe builds.
//
// `unorm` and `ucase` are not in the probe and do not build for a
// device.  Their tables are 148 KB generated, which is more than half
// of an nRF52's flash, and firmware that genuinely needs normalisation
// reaches it through `udata.data_from_pack` with the tables in an
// external flash region the host read for it.  The README says which
// half is which.
//
// The eight checks below answer correctly under a toolchain newer than
// 0.9.1.  Under 0.9.1 the length of a `Str` constant on the bare-metal
// runtime stops at the first NUL and `str.byte_at_or` bounds-checks
// against that short length, so a byte table compiled into a constant
// is unreadable on a device.  Every table here opens with the entry for
// U+0000, whose three key bytes are zero, so the three checks that read
// a table answer wrongly and the probe prints
// `FAIL: unicode-embedded 5`.
//
// Nothing here encodes around that.  An alphabet that avoided `\x00`
// would cost a quarter of the table size and would hide the fault from
// the next package to meet it.
//
// The three modules the probe names read 38 KB of generated table
// between them, which is the width classes, the UAX #29 break classes
// and the predicate bits, and the image carries them.  So a green run
// is the 38 KB fitting and the lookups running with no allocator,
// rather than the signatures merely type-checking.
// `tools/alloc_scan.sh` reads the other half off the emitted LLVM on
// the host.
//
// `uclass` reaches `udata` for `category`, and `udata` reaches all
// three tables behind a `UniData`, so the compilation unit holds them.
// Every function that touches them carries `@tier(app)`, nothing in
// the probe reaches one, and the build drops a function the
// annotations keep off a device and the program cannot call.  That
// prune is what lets one package be both halves, and it is why
// `data_full` may allocate a handle while `char_width` may not.

use std.str
use uclass
use ugrapheme
use uwidth

// Every answer this probe checks, folded into one number so a single
// comparison decides the run.  A firmware image has one line of
// output; making it depend on all of them is what stops a passing run
// from meaning "the first call linked".
@tier(rt)
fn score() -> Int
    var n = 0
    // The width rule, which is the value textwrap-nv holds: one Int
    // in, one Int out, and no table argument anywhere in the call.
    if uwidth.char_width(0x41) == 1
        n = n + 1
    if uwidth.char_width(0x4E16) == 2
        n = n + 1
    if uwidth.is_zero_width(0x0301)
        n = n + 1
    // The break machine as a value, fed one codepoint, with the next
    // state read back off the step it returned.  This is the shape a
    // terminal uses and the one that has to work with no heap.
    let s = ugrapheme.break_state()
    let first = ugrapheme.break_step(s, 0x61)
    if first.boundary
        n = n + 1
    let second = ugrapheme.break_step(first.state, 0x0308)
    if second.boundary == false
        n = n + 1
    if second.state.regional_run == 0
        n = n + 1
    // The predicates that take no data handle.
    if uclass.is_ascii_digit(0x30)
        n = n + 1
    if uclass.is_valid_scalar(0xD800) == false
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 8 is the number of checks in `score` on the path a linked build
    // takes.  The count is printed on a failure rather than only
    // compared, so a device that disagrees with the host says how many
    // it lost and a bisect has somewhere to start.
    let n = score()
    if n == 8
        hal.uart.write("PASS: unicode-embedded\n")
    else
        hal.uart.write("FAIL: unicode-embedded ")
        hal.uart.write(str.from_int(n))
        hal.uart.write("\n")
    loop
        core.rt.sleep_ms(1000)
