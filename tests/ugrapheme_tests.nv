// ugrapheme_tests.nv — the API suite for grapheme cluster
// segmentation.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: unicode-nv.ugrapheme.<fn>`.
//
// THE CASES ARE UAX #29's OWN.  `GraphemeBreakTest.txt` writes a
// boundary as `÷` and a non-boundary as `×`, and every case below
// names the line it came from in that notation, so the suite can be
// checked against the annex rather than against somebody's reading of
// it.  When the implementation lands, the whole of
// `GraphemeBreakTest.txt` — about 1100 cases — becomes a generated
// suite beside this one; these are the ones worth reading by hand.

use std.list
use std.str
use std.test
use ugrapheme

@test
fn test_the_machine_reports_a_boundary_before_the_first_codepoint() [io]
    // GB1: there is always a break at the start of text.  The
    // incremental surface has no other way to say so, and a caller
    // that placed the first codepoint without checking would put it
    // in a cluster that does not exist.
    let s = ugrapheme.break_state()
    let step = ugrapheme.break_step(s, 0x61)

    test.case("GB1 — ÷ 0061")
    test.assert(step.boundary)

@test
fn test_a_combining_mark_joins_its_base() [io]
    // GB9 — ÷ 0061 × 0308 ÷ : "a" then COMBINING DIAERESIS is one
    // cluster.  This is the case that makes `str.len` the wrong
    // answer to "how many characters", and it is one line of the
    // annex's test file.
    test.case("no boundary before the mark")
    let s0 = ugrapheme.break_state()
    let a = ugrapheme.break_step(s0, 0x61)
    let mark = ugrapheme.break_step(a.state, 0x0308)
    test.assert(mark.boundary == false)

    test.case("and the string surface agrees")
    test.assert(ugrapheme.count("a\u{0308}") == 1)

    test.case("a space with a mark on it is also one cluster — ÷ 0020 × 0308 ÷")
    test.assert(ugrapheme.count("\u{0020}\u{0308}") == 1)

@test
fn test_crlf_is_one_cluster_and_lfcr_is_two() [io]
    // GB3 — ÷ 000D × 000A ÷ .  The rule exists so that a backspace
    // over a Windows line ending removes the line ending rather than
    // half of it.  GB4 and GB5 are what make the reverse order two.
    test.case("GB3 — a carriage return and a line feed join")
    test.assert(ugrapheme.count("\r\n") == 1)

    test.case("GB4/GB5 — in the other order they do not")
    test.assert(ugrapheme.count("\n\r") == 2)

    test.case("and a control never joins what follows it")
    test.assert(ugrapheme.count("\r" + "a") == 2)

@test
fn test_regional_indicators_pair_up_and_then_start_again() [io]
    // GB12/GB13 — ÷ 1F1E6 × 1F1E7 ÷ 1F1E8 ÷ .  Two regional
    // indicators are a flag; a third starts a new one.  This is the
    // rule a state machine cannot get right from the previous
    // codepoint alone, which is why `UniBreakState` carries a count.
    test.case("a pair is one cluster")
    test.assert(ugrapheme.count("\u{1F1E6}\u{1F1E7}") == 1)

    test.case("three are two clusters, not one and not three")
    test.assert(ugrapheme.count("\u{1F1E6}\u{1F1E7}\u{1F1E8}") == 2)

    test.case("four are two")
    test.assert(ugrapheme.count("\u{1F1E6}\u{1F1E7}\u{1F1E8}\u{1F1E9}") == 2)

@test
fn test_a_zwj_emoji_sequence_is_one_cluster() [io]
    // GB11 — ÷ 1F468 × 200D × 1F469 ÷ .  A ZWJ joins only when what
    // precedes it is Extended_Pictographic, which is the whole
    // content of the rule and the reason `UniBreakState` carries a
    // flag for it.
    test.case("a pictograph, a joiner and a pictograph are one")
    test.assert(ugrapheme.count("\u{1F468}\u{200D}\u{1F469}") == 1)

    test.case("but a letter, a joiner and a letter are two — GB9/GB999")
    // 0061 × 200D ÷ 0062: the ZWJ joins backwards (GB9) and the "b"
    // does not join forwards, because "a" is not a pictograph.
    test.assert(ugrapheme.count("a\u{200D}b") == 2)

@test
fn test_hangul_syllables_join_by_jamo_class() [io]
    // GB6/GB7/GB8 — ÷ 1100 × 1161 × 11A8 ÷ : a leading, a vowel and
    // a trailing jamo are one syllable.
    test.case("L V T is one cluster")
    test.assert(ugrapheme.count("\u{1100}\u{1161}\u{11A8}") == 1)

    test.case("but T L is two — a trailing jamo does not lead")
    test.assert(ugrapheme.count("\u{11A8}\u{1100}") == 2)

@test
fn test_a_spacing_mark_joins_and_a_prepend_leads() [io]
    // GB9a — ÷ 0061 × 0903 ÷ : DEVANAGARI SIGN VISARGA is a
    // SpacingMark.  It takes a cell of its own and still belongs to
    // the cluster before it, which is the case that shows cluster
    // count and display width are different questions.
    test.case("GB9a — a spacing mark joins its base")
    test.assert(ugrapheme.count("a\u{0903}") == 1)

    test.case("GB9b — a prepend joins what follows it")
    test.assert(ugrapheme.count("\u{0600}a") == 1)

@test
fn test_the_cursor_walks_byte_ranges_into_the_caller_s_string() [io]
    // A range and not a copied string: a segmenter that allocated per
    // cluster would allocate once per character of the input, and the
    // caller is going to slice anyway.
    let text = "a\u{0308}b"
    let c = ugrapheme.cursor(text)

    test.case("the first cluster is the base and its mark, three bytes")
    match ugrapheme.cursor_next(c)
        None      =>
            test.assert(false)
        Some(one) =>
            test.assert(one.start == 0)
            test.assert(one.end == 3)

    test.case("and the walk ends where the string does")
    let c2 = ugrapheme.cursor_advance(c)
    match ugrapheme.cursor_next(c2)
        None      =>
            test.assert(false)
        Some(two) =>
            test.assert(two.start == 3)
            test.assert(two.end == 4)
    test.assert(ugrapheme.cursor_done(ugrapheme.cursor_advance(c2)))

@test
fn test_boundaries_answer_the_cursor_key_questions() [io]
    let text = "a\u{0308}b"

    test.case("the next boundary after the base is past its mark")
    test.assert(ugrapheme.next_boundary(text, 0) == 3)

    test.case("backspace from the end removes one cluster, not one byte")
    test.assert(ugrapheme.prev_boundary(text, 4) == 3)
    test.assert(ugrapheme.prev_boundary(text, 3) == 0)

    test.case("an offset inside a codepoint is not a boundary")
    test.assert(ugrapheme.is_boundary(text, 2) == false)
    test.assert(ugrapheme.is_boundary(text, 0))
    test.assert(ugrapheme.is_boundary(text, 3))

    test.case("and next_boundary at the end returns the end, so a loop terminates")
    test.assert(ugrapheme.next_boundary(text, 3) == 4)

@test
fn test_nth_and_truncate_are_the_questions_a_program_really_asks() [io]
    let text = "a\u{0308}bc"

    test.case("nth is a range, and past the end is None")
    match ugrapheme.nth(text, 1)
        None    =>
            test.assert(false)
        Some(r) =>
            test.assert(r.start == 3)
            test.assert(r.end == 4)
    test.assert(ugrapheme.nth(text, 9) == None)

    test.case("truncate answers in bytes, cutting at a cluster")
    test.assert(ugrapheme.truncate_clusters(text, 2) == 4)
    test.assert(ugrapheme.truncate_clusters(text, 0) == 0)

    test.case("asking for more clusters than there are returns the whole string")
    test.assert(ugrapheme.truncate_clusters(text, 99) == 5)

    test.case("clusters is the allocating convenience over the same walk")
    test.assert(list.len(ugrapheme.clusters(text)) == 3)

@test
fn test_a_cursor_can_start_part_way_through() [io]
    // What a renderer resuming at a scroll position needs.  An offset
    // inside a codepoint moves BACK rather than producing a range that
    // cuts one in half.
    let text = "a\u{0308}bc"

    test.case("a cursor started at a cluster boundary sees the rest")
    let c = ugrapheme.cursor_at(text, 3)
    match ugrapheme.cursor_next(c)
        None    =>
            test.assert(false)
        Some(r) =>
            test.assert(r.start == 3)

    test.case("and one started inside a codepoint is moved back to its start")
    let mid = ugrapheme.cursor_at(text, 2)
    test.assert(mid.at == 1)

@test
fn test_word_boundaries_keep_the_gaps() [io]
    // A segmenter that dropped the spaces could not report a byte
    // offset, and a tokenizer needs one.  So every segment is
    // returned, with its kind.
    let text = "one two"

    test.case("three segments: a word, a space, a word")
    let w = ugrapheme.words(text)
    test.assert(list.len(w) == 3)
    test.assert(list.get(w, 0).kind == WordLetters)
    test.assert(list.get(w, 1).kind == WordSpace)
    test.assert(list.get(w, 2).start == 4)

    test.case("delete-previous-word lands at the start of the last one")
    test.assert(ugrapheme.prev_word(text, 7) == 4)

    test.case("and next_word steps over the word, not over the space")
    test.assert(ugrapheme.next_word(text, 0) == 3)

@test
fn test_an_indic_conjunct_is_one_cluster() [io]
    // GB9c, added in Unicode 15.1 and the newest rule in the annex: a
    // consonant, a virama and another consonant are one cluster,
    // because that is what a reader sees and what a backspace should
    // remove.  It is the rule `UniBreakState.linker_run` exists for,
    // and the one that cannot be decided from the previous codepoint.
    test.case("ka, virama, ta — DEVANAGARI, one conjunct")
    test.assert(ugrapheme.count("\u{0915}\u{094D}\u{0924}") == 1)

    test.case("but a virama after something that is not a consonant does not join")
    test.assert(ugrapheme.count("a\u{094D}\u{0924}") == 2)

    test.case("and the counter is visible in the state the machine hands back")
    let s0 = ugrapheme.break_state()
    let ka = ugrapheme.break_step(s0, 0x0915)
    test.assert(ka.state.linker_run == 0)
    let virama = ugrapheme.break_step(ka.state, 0x094D)
    test.assert(virama.state.linker_run == 1)
    let ta = ugrapheme.break_step(virama.state, 0x0924)
    test.assert(ta.boundary == false)
    test.assert(ta.state.linker_run == 0)

    test.case("a codepoint outside Unicode opens no conjunct and joins nothing")
    let odd = ugrapheme.break_step(s0, 0x110000)
    test.assert(odd.boundary)
    test.assert(odd.state.linker_run == 0 - 1)

@test
fn test_the_cursor_answers_none_at_the_end_and_is_clamped_at_both() [io]
    // A cursor is what a renderer resuming at a scroll position holds,
    // and a scroll position is arithmetic somebody else did.
    let text = "ab"

    test.case("a cursor past the end is done and has nothing to give")
    let past = ugrapheme.cursor_at(text, 99)
    test.assert(ugrapheme.cursor_done(past))
    test.assert(ugrapheme.cursor_next(past) == None)

    test.case("and one before the start is moved to it")
    let before = ugrapheme.cursor_at(text, 0 - 4)
    test.assert(before.at == 0)

    test.case("the boundary questions are clamped the same way")
    test.assert(ugrapheme.next_boundary(text, 99) == 2)
    test.assert(ugrapheme.prev_boundary(text, 0) == 0)
    test.assert(ugrapheme.nth(text, 0 - 1) == None)
    test.assert(ugrapheme.truncate_clusters(text, 0 - 1) == 0)

@test
fn test_every_kind_of_word_segment_is_reported_as_what_it_holds() [io]
    // A tokenizer wants the letters and not the spaces; a word count
    // wants the same; a double-click that selected the run of spaces
    // between two words did the wrong thing.  So the kind is on the
    // segment, and all four arms are reachable.
    let text = "ab 12 ·\u{4E16}"

    test.case("letters, spaces, numbers, punctuation and a script UAX #29 leaves to a dictionary")
    let w = ugrapheme.words(text)
    test.assert(list.get(w, 0).kind == WordLetters)
    test.assert(list.get(w, 1).kind == WordSpace)
    test.assert(list.get(w, 2).kind == WordNumeric)
    test.assert(list.get(w, 3).kind == WordSpace)
    test.assert(list.get(w, 4).kind == WordOther)
    test.assert(list.get(w, 5).kind == WordLetters)

    test.case("the segments tile the string with no gap and no overlap")
    var at = 0
    for i in 0..list.len(w)
        test.assert(list.get(w, i).start == at)
        at = list.get(w, i).end
    test.assert(at == str.len(text))

@test
fn test_the_word_rules_that_join_across_a_character() [io]
    // WB6 and WB7 join two letters across a full stop or an
    // apostrophe; WB7a, WB7b and WB7c are Hebrew's three; WB11 and
    // WB12 do the same for numbers; WB13a and WB13b are the
    // connectors.  Each is a rule a naive split-on-non-letter gets
    // wrong, and each has its own arm.
    test.case("WB6/WB7 — a full stop between letters does not end a word")
    test.assert(list.len(ugrapheme.words("a.b")) == 1)

    test.case("WB11/WB12 — nor does a comma between digits")
    test.assert(list.len(ugrapheme.words("1,2")) == 1)

    test.case("WB7a — a Hebrew letter keeps a following apostrophe")
    test.assert(list.len(ugrapheme.words("\u{05D0}'")) == 1)

    test.case("WB7b/WB7c — and a quotation mark between two Hebrew letters")
    test.assert(list.len(ugrapheme.words("\u{05D0}\"\u{05D1}")) == 1)

    test.case("WB13 — katakana runs together")
    test.assert(list.len(ugrapheme.words("\u{30A2}\u{30A4}")) == 1)

    test.case("WB13a/WB13b — an underscore joins what is on both sides of it")
    test.assert(list.len(ugrapheme.words("a_1")) == 1)
    test.assert(list.len(ugrapheme.words("_a")) == 1)

    test.case("WB3a/WB3b — a newline ends a word on both sides")
    test.assert(list.len(ugrapheme.words("a\nb")) == 3)

    test.case("WB15/WB16 — regional indicators pair here too")
    test.assert(list.len(ugrapheme.words("\u{1F1E6}\u{1F1E7}")) == 1)

    test.case("and the word walk is clamped like the cluster walk")
    test.assert(ugrapheme.next_word("ab", 99) == 2)
    test.assert(ugrapheme.prev_word("ab", 0) == 0)

@test
fn test_a_windows_line_ending_is_one_word_segment_and_not_two() [io]
    // WB3 — CR × LF.  The same reason GB3 exists: a line ending is one
    // thing, and a "delete previous word" that removed half of one
    // would leave a lone carriage return in the buffer.
    test.case("CR and LF do not part")
    let w = ugrapheme.words("a\r\nb")
    test.assert(list.len(w) == 3)
    test.assert(list.get(w, 1).start == 1)
    test.assert(list.get(w, 1).end == 3)
    test.assert(list.get(w, 1).kind == WordSpace)

    test.case("and the other order is two segments")
    test.assert(list.len(ugrapheme.words("\n\r")) == 2)

@test
fn test_segmenting_bytes_that_are_not_text_still_terminates() [io]
    // A segmenter is called on whatever the program has.  A four-byte
    // sequence that decodes ABOVE U+10FFFF is well-formed UTF-8 in
    // shape and not a codepoint at all; it has no properties, so it
    // joins nothing and is its own segment.
    let over = str.from_byte(0xF4) + str.from_byte(0x90) + str.from_byte(0x80) + str.from_byte(0x80)

    test.case("it is one cluster and one word segment")
    test.assert(ugrapheme.count(over) == 1)
    test.assert(list.len(ugrapheme.words(over)) == 1)
    test.assert(list.get(ugrapheme.words(over), 0).kind == WordOther)

    test.case("and a truncated sequence does not stall the walk")
    let cut = str.from_byte(0xE4) + "a"
    test.assert(ugrapheme.count(cut) == 2)
