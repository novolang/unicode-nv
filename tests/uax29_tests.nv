// END GENERATED CASES: WORD_CASES

// The codepoints of one case, joined into the string it describes.
//
// The annex's markers are dropped here and read back by `marked_at`,
// so the two halves of a case cannot drift out of step: one walk over
// the tokens produces both.
fn case_text(line: Str) -> Str
    let tokens = str.words(line)
    var out = ""
    for i in 0..list.len(tokens)
        let t = list.get(tokens, i)
        if is_hex(t)
            out = out + str.from_char(hex_of(t))
    out

// The byte offsets the case says are boundaries.
fn case_boundaries(line: Str) -> [Int] [io]
    let tokens = str.words(line)
    var out: [Int] = []
    var at = 0
    for i in 0..list.len(tokens)
        let t = list.get(tokens, i)
        if is_hex(t)
            at = at + str.len(str.from_char(hex_of(t)))
        elif hex_of(t) == 0 and str.len(t) > 0
            // A marker, not a number.  `÷` is a boundary at the byte
            // count reached so far; `×` says the opposite and needs no
            // record, because the check is over the list of boundaries
            // rather than over the list of positions.
            if utf8_first(t) == DIVIDE
                out = list.push(out, at)
    out

// Whether a token is a run of hex digits, which is how the annex writes
// a codepoint.
fn is_hex(t: Str) -> Bool
    var ok = str.len(t) > 0
    for i in 0..str.len(t)
        let b = str.byte_at_or(t, i, 0)
        if (b < '0' or b > '9') and (b < 'A' or b > 'F') and (b < 'a' or b > 'f')
            ok = false
    ok

// The value of a hex token, or 0 for a token that is not one.
fn hex_of(t: Str) -> Int
    var v = 0
    for i in 0..str.len(t)
        let b = str.byte_at_or(t, i, 0)
        if b >= '0' and b <= '9'
            v = v * 16 + (b - '0')
        elif b >= 'A' and b <= 'F'
            v = v * 16 + (b - 'A') + 10
        elif b >= 'a' and b <= 'f'
            v = v * 16 + (b - 'a') + 10
    v

// The first codepoint of a token, for telling the two markers apart.
fn utf8_first(t: Str) -> Int
    let b = str.byte_at_or(t, 0, 0)
    if b < 0x80
        b
    else
        ((b & 0x1F) << 6) | (str.byte_at_or(t, 1, 0) & 0x3F)

// Every cluster boundary of `text`, in order, ending at its length.
fn grapheme_boundaries(text: Str) -> [Int] [io]
    var out = [0]
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        at = ugrapheme.next_boundary(text, at)
        out = list.push(out, at)
    out

// Every word boundary of `text`, in order, ending at its length.
fn word_boundaries(text: Str) -> [Int] [io]
    var out = [0]
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        at = ugrapheme.next_word(text, at)
        out = list.push(out, at)
    out

// Whether two lists of byte offsets are the same list.
fn same(a: [Int], b: [Int]) -> Bool
    var ok = list.len(a) == list.len(b)
    if ok
        for i in 0..list.len(a)
            if list.get(a, i) != list.get(b, i)
                ok = false
    ok

// The corpus for one annex file: the whole thing when `NOVO_UCD` names
// a directory holding it, and the committed sample otherwise.
//
// The sample is what `novo test` runs, so the suite is green on a
// machine that has never downloaded the UCD; the whole file is what a
// release is verified against.
fn corpus(committed: Str, file_name: Str) -> [Str] [io, fs]
    match env.get("NOVO_UCD")
        None => str.split(committed, "\n")
        Some(dir) =>
            match fs.read(dir + "/auxiliary/" + file_name)
                None => str.split(committed, "\n")
                Some(whole) => usable_lines(whole)

// The cases of a whole annex file: comments and blank lines dropped.
fn usable_lines(whole: Str) -> [Str]
    var out: [Str] = []
    let lines = str.split_lines(whole)
    for i in 0..list.len(lines)
        let line = list.get(lines, i)
        let body = str.trim(before_hash(line))
        if str.len(body) > 0
            out = list.push(out, body)
    out

// A line with its trailing comment removed.
fn before_hash(line: Str) -> Str
    match str.index(line, "#")
        None => line
        Some(at) => str.slice(line, 0, at)

@test
fn test_grapheme_cluster_boundaries_match_the_annex() [io, fs]
    // GB1 through GB999, as the annex itself states them.  A failure
    // here names the case in the annex's notation, so it can be looked
    // up in `GraphemeBreakTest.txt` by searching for the line.
    let rows = corpus(GRAPHEME_CASES, "GraphemeBreakTest.txt")
    var failed = 0
    var first = ""
    for i in 0..list.len(rows)
        let line = list.get(rows, i)
        let text = case_text(line)
        if same(grapheme_boundaries(text), case_boundaries(line)) == false
            failed = failed + 1
            if str.len(first) == 0
                first = line
    test.case("every case in GraphemeBreakTest.txt: " + str.from_int(list.len(rows)) + " cases, first failure: " + first)
    test.assert(failed == 0)
    test.assert(list.len(rows) > 100)

@test
fn test_word_boundaries_match_the_annex() [io, fs]
    // WB1 through WB999.  The three rules that read the codepoint AFTER
    // the one being decided — WB6, WB7b and WB12 — are the ones this
    // file is really checking, because they are the ones a state
    // machine cannot do and the reason the word surface takes a string.
    let rows = corpus(WORD_CASES, "WordBreakTest.txt")
    var failed = 0
    var first = ""
    for i in 0..list.len(rows)
        let line = list.get(rows, i)
        let text = case_text(line)
        if same(word_boundaries(text), case_boundaries(line)) == false
            failed = failed + 1
            if str.len(first) == 0
                first = line
    test.case("every case in WordBreakTest.txt: " + str.from_int(list.len(rows)) + " cases, first failure: " + first)
    test.assert(failed == 0)
    test.assert(list.len(rows) > 100)

@test
fn test_the_two_grapheme_surfaces_cannot_disagree() [io]
    // The string functions are written on the state machine, and this
    // is that claim as a test: the boundaries a cursor walks are the
    // boundaries `break_step` reports, over every case in the sample.
    let rows = str.split(GRAPHEME_CASES, "\n")
    var failed = 0
    for i in 0..list.len(rows)
        let text = case_text(list.get(rows, i))
        if same(grapheme_boundaries(text), stepped_boundaries(text)) == false
            failed = failed + 1
    test.case("the cursor and the state machine agree on every committed case")
    test.assert(failed == 0)

// The boundaries the incremental surface reports, walked by hand.
fn stepped_boundaries(text: Str) -> [Int] [io]
    var out: [Int] = []
    var st = ugrapheme.break_state()
    var at = 0
    for _ in 0..str.len(text)
        if at >= str.len(text)
            break
        let step = ugrapheme.break_step(st, cp_at(text, at))
        if step.boundary
            out = list.push(out, at)
        st = step.state
        at = at + seq_len(text, at)
    list.push(out, str.len(text))

// The codepoint at byte `i`, for a suite that cannot reach `utbl`.
fn cp_at(text: Str, i: Int) -> Int
    let b = str.byte_at_or(text, i, 0)
    if b < 0x80
        b
    elif b < 0xE0
        ((b & 0x1F) << 6) | (str.byte_at_or(text, i + 1, 0) & 0x3F)
    elif b < 0xF0
        ((b & 0x0F) << 12) | ((str.byte_at_or(text, i + 1, 0) & 0x3F) << 6) | (str.byte_at_or(text, i + 2, 0) & 0x3F)
    else
        ((b & 0x07) << 18) | ((str.byte_at_or(text, i + 1, 0) & 0x3F) << 12) | ((str.byte_at_or(text, i + 2, 0) & 0x3F) << 6) | (str.byte_at_or(text, i + 3, 0) & 0x3F)

// How many bytes the sequence at `i` occupies.
fn seq_len(text: Str, i: Int) -> Int
    let b = str.byte_at_or(text, i, 0)
    if b < 0x80
        1
    elif b < 0xE0
        2
    elif b < 0xF0
        3
    else
        4
