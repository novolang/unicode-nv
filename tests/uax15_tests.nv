15 0300 05AE 1E130 0062;00E0 05AE 1E130 0315 0062;0061 05AE 0300 1E130 0315 0062;00E0 05AE 1E130 0315 0062;0061 05AE 0300 1E130 0315 0062;\n0061 1E949 0315 0300 05AE 0062;0061 05AE 1E949 0300 0315 0062;0061 05AE 1E949 0300 0315 0062;0061 05AE 1E949 0300 0315 0062;0061 05AE 1E949 0300 0315 0062;\n1110 0334 1163;1110 0334 1163;1110 0334 1163;1110 0334 1163;1110 0334 1163;\nC1A8 0334 11AE;C1A8 0334 11AE;1109 116A 0334 11AE;C1A8 0334 11AE;1109 116A 0334 11AE;\n115B8 0334 115AF;115B8 0334 115AF;115B8 0334 115AF;115B8 0334 115AF;115B8 0334 115AF;\n00E7 0341;1E09;0063 0327 0301;1E09;0063 0327 0301;\n00E2 0309;1EA9;0061 0302 0309;1EA9;0061 0302 0309;\n00D2 031B;1EDC;004F 031B 0300;1EDC;004F 031B 0300;\n1F09 0342;1F0F;0391 0314 0342;1F0F;0391 0314 0342;\n1F40 0301;1F44;03BF 0313 0301;1F44;03BF 0313 0301;\n1FB3 0343 0300;1F82;03B1 0313 0300 0345;1F82;03B1 0313 0300 0345;\n1F09 0300 0345;1F8B;0391 0314 0300 0345;1F8B;0391 0314 0300 0345;\n1FC3 0314 0340;1F93;03B7 0314 0300 0345;1F93;03B7 0314 0300 0345;\n1F28 0341 0345;1F9C;0397 0313 0301 0345;1F9C;0397 0313 0301 0345;\n1FF3 0343 0301;1FA4;03C9 0313 0301 0345;1FA4;03C9 0313 0301 0345;\n1F69 0301 0345;1FAD;03A9 0314 0301 0345;1FAD;03A9 0314 0301 0345;\n1611E 16123;16126;1611E 1611E 1611F;16126;1611E 1611E 1611F;"
// END GENERATED CASES: NORMALIZATION_CASES

// The five columns of one case, as the strings they describe.
fn columns(line: Str) -> [Str]
    let fields = str.split(line, ";")
    list.map(list.slice(fields, 0, 5), cps_of)

// A column — space-separated hex codepoints — as a string.
fn cps_of(field: Str) -> Str
    let tokens = str.words(field)
    var out = ""
    for i in 0..list.len(tokens)
        out = out + str.from_char(hex_of(list.get(tokens, i)))
    out

// The value of a hex token.
fn hex_of(t: Str) -> Int
    var v = 0
    for i in 0..str.len(t)
        let b = str.byte_at_or(t, i, 0)
        if b >= '0' and b <= '9'
            v = v * 16 + (b - '0')
        elif b >= 'A' and b <= 'F'
            v = v * 16 + (b - 'A') + 10
        elif b >= 'a' and b <= 'f'
            v = v * 16 + (b - 'a') + 10
    v

// The corpus: the whole file when `NOVO_UCD` names a directory holding
// it, and the committed sample otherwise.
fn corpus() -> [Str] [io, fs]
    match env.get("NOVO_UCD")
        None      => str.split(NORMALIZATION_CASES, "\n")
        Some(dir) =>
            match fs.read(dir + "/NormalizationTest.txt")
                None        => str.split(NORMALIZATION_CASES, "\n")
                Some(whole) => usable_lines(whole)

// The cases of the whole file: comments, blank lines and the `@Part`
// section headers dropped.
fn usable_lines(whole: Str) -> [Str]
    var out: [Str] = []
    let lines = str.split_lines(whole)
    for i in 0..list.len(lines)
        let body = str.trim(before_hash(list.get(lines, i)))
        if str.len(body) > 0 and str.starts_with(body, "@") == false
            out = list.push(out, body)
    out

// A line with its trailing comment removed.
fn before_hash(line: Str) -> Str
    match str.index(line, "#")
        None     => line
        Some(at) => str.slice(line, 0, at)

// How many of one case's twenty equalities fail.
fn failures(d: udata.UniData, line: Str) -> Int
    let c = columns(line)
    let c1 = list.get(c, 0, "")
    let c2 = list.get(c, 1, "")
    let c3 = list.get(c, 2, "")
    let c4 = list.get(c, 3, "")
    let c5 = list.get(c, 4, "")
    var bad = 0
    for i in 0..3
        let source = list.get(c, i, "")
        if unorm.normalize(d, source, FormNfc) != c2
            bad = bad + 1
        if unorm.normalize(d, source, FormNfd) != c3
            bad = bad + 1
    for i in 3..5
        let source = list.get(c, i, "")
        if unorm.normalize(d, source, FormNfc) != c4
            bad = bad + 1
        if unorm.normalize(d, source, FormNfd) != c5
            bad = bad + 1
    for i in 0..5
        let source = list.get(c, i, "")
        if unorm.normalize(d, source, FormNfkc) != c4
            bad = bad + 1
        if unorm.normalize(d, source, FormNfkd) != c5
            bad = bad + 1
    if str.len(c1) == 0
        bad = bad + 1
    bad

@test
fn test_the_four_forms_match_the_annex() [io, fs]
    // Twenty equalities per case, which is what UAX #15's conformance
    // clause asks for and is more than "does NFC work": it is also
    // that normalising an already-normalised string is a fixed point,
    // which is the property a cache key depends on.
    let d = udata.data_full()
    let rows = corpus()
    var failed = 0
    var first = ""
    for i in 0..list.len(rows)
        let line = list.get(rows, i)
        if failures(d, line) > 0
            failed = failed + 1
            if str.len(first) == 0
                first = line
    test.case("every case in NormalizationTest.txt: " + str.from_int(list.len(rows)) + " cases, first failure: " + first)
    test.assert(failed == 0)
    test.assert(list.len(rows) > 100)

@test
fn test_is_normalized_agrees_with_normalize() [io]
    // `quick_check` and `is_normalized` exist so that a caller can skip
    // the work, and a cheap answer that disagreed with the expensive
    // one would be worse than no cheap answer.  So: every normalised
    // column of every committed case reports itself normalised, and
    // every one that differs from its source reports the source is not.
    let d = udata.data_full()
    let rows = str.split(NORMALIZATION_CASES, "\n")
    var wrong = 0
    for i in 0..list.len(rows)
        let c = columns(list.get(rows, i))
        let c1 = list.get(c, 0, "")
        let c2 = list.get(c, 1, "")
        let c3 = list.get(c, 2, "")
        if unorm.is_normalized(d, c2, FormNfc) == false
            wrong = wrong + 1
        if unorm.is_normalized(d, c3, FormNfd) == false
            wrong = wrong + 1
        if c1 != c2 and unorm.is_normalized(d, c1, FormNfc)
            wrong = wrong + 1
    test.case("the cheap answer and the expensive one agree on every committed case")
    test.assert(wrong == 0)

@test
fn test_canonical_equivalence_holds_across_the_columns() [io]
    // `compare` decides equivalence without building either normalised
    // form, so it has its own way to be wrong.  Columns 1, 2 and 3 of
    // every case are canonically equivalent by construction, which
    // makes the file an oracle for this function too.
    let d = udata.data_full()
    let rows = str.split(NORMALIZATION_CASES, "\n")
    var wrong = 0
    for i in 0..list.len(rows)
        let c = columns(list.get(rows, i))
        let c1 = list.get(c, 0, "")
        let c2 = list.get(c, 1, "")
        let c3 = list.get(c, 2, "")
        if unorm.equivalent(d, c1, c2, FormNfc) == false
            wrong = wrong + 1
        if unorm.equivalent(d, c1, c3, FormNfc) == false
            wrong = wrong + 1
        if unorm.compare(d, c2, c3, FormNfc) != 0
            wrong = wrong + 1
    test.case("columns 1, 2 and 3 compare equal on every committed case")
    test.assert(wrong == 0)
